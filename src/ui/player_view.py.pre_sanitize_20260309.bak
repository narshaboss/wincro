                            else:
                                mapping_on = not _no_save
                                mark_portal_entry = True
                            if _segment_map_locked:
                                mapping_on = False
                            portal_grace = 30
                            prev_x, prev_y = current_x, current_y
                            time.sleep(0.05)
                            continue

                        # ?? 紐⑺몴 寃곗젙: 蹂댁뒪 異붿쟻 ?곗꽑, ?놁쑝硫??쒖같 ??
                        if _boss_chasing:
                            _move_target = (_chase_tx, _chase_ty)
                        else:
                            _move_target_raw = boss_patrol.get_next_target(current_pos_tuple)
                            if _move_target_raw is None:
                                self.after(0, lambda: self._append_log("?좑툘 ?쒖같 醫뚰몴 ?놁쓬 ???먯깋 蹂듦?"))
                                boss_mode = "exploring"
                                boss_patrol = None
                                _boss_chasing = False
                                _boss_chase_miss = 0
                                stuck_count = 0
                                total_stuck_count = 0
                                last_dir = None
                                current_path = []
                                path_index = 0
                                path_pos_index = {}
                                explored_from = {}
                                unknown_path_fails = 0
                                boss_no_frontier_count = 0
                                frontier_cooldown.clear()
                                explore_unreachable = set()
                                boss_approach_steps = 0
                                boss_appr_miss = 0
                                patrol_skip_count = 0
                                explore_target = None
                                explore_target_tries = 0
                                prev_x, prev_y = current_x, current_y
