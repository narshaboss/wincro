                                continue
                            _move_target = (_move_target_raw[0], _move_target_raw[1])

                        # A* 寃쎈줈 怨꾩궛 (罹먯떆 ?쒖슜 ??紐⑺몴/寃쎈줈 蹂寃??쒖뿉留??ш퀎??
                        # 蹂댁뒪 異붿쟻 ??allow_unknown=True (誘명깘???곸뿭??蹂댁뒪??異붿쟻 媛??
                        pathfinder.set_goal(_move_target)
