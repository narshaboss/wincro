        # ?ㅽ뻾 踰꾪듉 ?꾨젅??        play_btn_frame = ctk.CTkFrame(self._selection_card, fg_color="transparent")
        play_btn_frame.pack(fill="x", padx=15, pady=(0, 8))

        self._play_btn = ctk.CTkButton(
