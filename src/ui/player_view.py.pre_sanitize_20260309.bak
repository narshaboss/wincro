                                                        # ?ㅼ쓬踰덉뿏 諛섎? 諛⑺뼢 ?ㅼ틪
                                                        self._boss_x_scan_dir *= -1
                                                        self.after(0, lambda cx=current_x, cy=current_y,
                                                                   tx=_chase_tx, ty=_chase_ty, td=_td2, dy=_dy2:
                                                            self._append_log(f"?봽 Y洹쇱젒({td}??? X?먯깋 ??({tx},{ty})"))
                                                    else:
                                                        # ?고쉶 遺덇? ??誘멸컧吏 泥섎━ (miss ?꾩쟻 ??15?????쒖같 蹂듦?)
                                                        _rechk_found = False
                                                        self._boss_x_scan_dir *= -1  # 諛⑺뼢 ?꾪솚
                                                        self.after(0, lambda cx=current_x, cy=current_y, td=_td2, dy=_dy2:
                                                            self._append_log(f"?좑툘 Y洹쇱젒({td}??? X?먯깋 ?ㅽ뙣+?고쉶遺덇?"))
                                            else:
                                                _chase_tx = current_x  # X offset 臾댁떆 (UI NAME 怨좎젙)
                                                _chase_ty = current_y + _edy2
                                                # start_pos 諛잛? ?딅룄濡??뺤씤
                                                _rchk_sp = self._game_map.start_pos
                                                if _rchk_sp is not None and (_chase_tx, _chase_ty) == _rchk_sp:
                                                    # start_pos硫?Y諛⑺뼢?쇰줈 1??????대룞
                                                    _rchk_dy_sign = 1 if _edy2 >= 0 else -1
                                                    _chase_ty += _rchk_dy_sign
                                                _boss_chase_miss = 0
                                                self.after(0, lambda cx=current_x, cy=current_y,
                                                       tx=_chase_tx, ty=_chase_ty, td=_td2:
                                                self._append_log(f"?봽 ?ш컧吏! ({cx},{cy})??{tx},{ty}) 嫄곕━={td}???))
                                except Exception:
                                    pass
                                if not _rechk_found and not self._stop_event.is_set():
                                    _boss_chase_miss += 1
                                    if _boss_chase_miss >= 15:
                                        _boss_chasing = False
                                        _boss_chase_miss = 0
                                        # ?꾩옱 ?꾩튂?먯꽌 媛??媛源뚯슫 ?쒖같 ?ъ씤?몃????ъ떆??                                        if boss_patrol is not None:
                                            boss_patrol.start((current_x, current_y))
                                        self.after(0, lambda cx=current_x, cy=current_y:
                                            self._append_log(f"?뵇 蹂댁뒪 誘멸컧吏 ???쒖같 蹂듦? (({cx},{cy})遺??"))
                                    else:
                                        if _ui_update_ok:
                                            self.after(0, lambda tx=_move_target[0], ty=_move_target[1], m=_boss_chase_miss:
                                                self._append_log(f"?좑툘 異붿쟻 ({tx},{ty}) ?ш컧吏 ?ㅽ뙣 ({m}/15)"))
                                        self._stop_event.wait(0.05)
                            else:
                                boss_patrol.skip_current_target()
                                patrol_skip_count += 1
                                self.after(0, lambda tx=_move_target[0], ty=_move_target[1]:
                                    self._append_log(f"?좑툘 ?쒖같 ({tx},{ty}) ?꾨떖 遺덇? ???ㅽ궢"))
                                patrol_total = len(self._game_map.patrol_points)
                                skip_threshold = min(patrol_total, 15)
                                if patrol_skip_count >= skip_threshold and patrol_total > 0:
                                    boss_mode = "exploring"
                                    boss_patrol = None
                                    _boss_chasing = False
                                    _boss_chase_miss = 0
                                    last_dir = None
                                    stuck_count = 0
                                    total_stuck_count = 0
                                    patrol_skip_count = 0
                                    explore_target = None
                                    explore_target_tries = 0
                                    explore_unreachable = set()
                                    frontier_cooldown.clear()
                                    explored_from = {}
                                    unknown_path_fails = 0
                                    boss_no_frontier_count = 0
                                    boss_approach_steps = 0
                                    boss_appr_miss = 0
                                    self.after(0, lambda ps=patrol_skip_count:
                                        self._append_log(f"?봽 ?쒖같 {ps}媛??곗냽 ?꾨떖遺덇? ???먯깋紐⑤뱶 蹂듦?"))
                            current_path = []
                            path_index = 0
                            path_pos_index = {}
                            pathfinder.invalidate_path()
                            prev_x, prev_y = current_x, current_y
                            self._stop_event.wait(0.05)
                            continue

                        if not self._stop_event.is_set() and _ui_update_ok:
                            if _boss_chasing:
                                self.after(0, lambda cx=current_x, cy=current_y, d=direction,
                                           tx=_move_target[0], ty=_move_target[1]:
                                    self._update_status("蹂댁뒪異붿쟻", f"({cx},{cy})",
                                        f"??{tx},{ty})", f"{d}", "?렞"))
                            else:
                                progress = boss_patrol.get_progress()
                                self.after(0, lambda cx=current_x, cy=current_y, p=progress, d=direction,
                                           tx=_move_target[0], ty=_move_target[1]:
                                    self._update_status("?쒖같以?, f"({cx},{cy})",
                                        f"??{tx},{ty})",
                                        f"{p['visited']}/{p['total']} ??{d}", "?뵇"))

                    if direction is None:
                        if not self._stop_event.is_set() and _ui_update_ok:
                            self.after(0, lambda cx=current_x, cy=current_y, m=boss_mode:
                                self._append_log(f"??({cx},{cy}) 蹂댁뒪?섏쟾 諛⑺뼢 ?놁쓬 ({m})"))
                        # 諛⑺뼢 ?놁쓬 ?곗냽 ???몄젒 踰??댁젣 蹂듦뎄 (exploring 紐⑤뱶 媛뉙옒 諛⑹?)
                        stuck_count += 1
                        if stuck_count >= 10 and mapping_on and use_map:
                            _unblocked = 0
                            if not _is_mapping_mode:
                                for _d, (_ddx, _ddy) in DIRECTIONS_4.items():
                                    _nx, _ny = current_x + _ddx, current_y + _ddy
                                    if (_nx, _ny) in _portal_protected:
                                        continue  # ?ы깉 醫뚰몴 蹂댄샇
                                    if self._game_map.is_blocked(_nx, _ny):
                                        self._game_map.mark_passable(_nx, _ny)
                                        _unblocked += 1
                                if _unblocked > 0:
                                    self.after(0, lambda u=_unblocked, cx=current_x, cy=current_y:
                                        self._append_log(f"?뵑 諛⑺뼢?놁쓬 蹂듦뎄 ({cx},{cy}) ??{u}媛??몄젒踰??댁젣"))
                            else:
                                _cleared_edge = 0
                                for _d in DIRECTIONS_4.keys():
                                    _ek = _edge_key(current_x, current_y, _d)
                                    if _ek in edge_blocked_moves:
                                        edge_blocked_moves.pop(_ek, None)
                                        _cleared_edge += 1
                                self._special_diag(
                                    "wall_unblock_skip_mapping",
                                    iter=iteration,
                                    trigger="direction_none",
                                    pos=f"{current_x},{current_y}",
                                    stuck=stuck_count,
                                    edge_clear=_cleared_edge,
                                )
                                if _cleared_edge > 0 and not self._stop_event.is_set() and _ui_update_ok:
                                    self.after(0, lambda cx=current_x, cy=current_y, ec=_cleared_edge:
                                        self._append_log(f"?㎛ 諛⑺뼢?놁쓬 蹂듦뎄: ({cx},{cy}) 李⑤떒?꾪솕 {ec}"))
                            stuck_count = 0
                            total_stuck_count = 0
                            explored_from.pop((current_x, current_y), None)
                            current_path = []
                            path_index = 0
                            path_pos_index = {}
                        _t_iter_total = int((time.time() - _t_iter_start) * 1000)
                        _timing_msg = f"??#{iteration} OCR:{_t_ocr_ms} sk:{_t_skill_ms} 珥?{_t_iter_total}ms ({current_x},{current_y}) 諛⑺뼢?놁쓬[{boss_mode}]"
                        logger.info(f"[??대컢] {_timing_msg}")
                        if _ui_update_ok:
                            self.after(0, lambda m=_timing_msg: self._append_log(m))
                        self._stop_event.wait(0.1)
                        # prev瑜??꾩옱 ?꾩튂濡????ㅼ쓬 諛섎났?먯꽌 ?대룞 ?먯젙 ?뺤긽 ?숈옉
                        prev_x, prev_y = current_x, current_y
                        last_dir = None
                        continue

                    if self._stop_event.is_set():
                        break

                    # 蹂댁뒪?섏쟾 諛⑺뼢 濡쒓렇 (10?뚮쭏??
                    if iteration % 10 == 0 and not self._stop_event.is_set():
                        self.after(0, lambda cx=current_x, cy=current_y, d=direction, m=boss_mode:
                            self._append_log(f"?렜 [{m}] ({cx},{cy}) ??{d}"))

                    _t_path_ms = int((time.time() - _t_iter_start) * 1000) - _t_ocr_ms
                    _t_key_start = time.time()
                    press_key(direction)
                    _t_key_ms = int((time.time() - _t_key_start) * 1000)
                    _t_iter_total = int((time.time() - _t_iter_start) * 1000)
                    _timing_msg = f"??#{iteration} OCR:{_t_ocr_ms} sk:{_t_skill_ms} A*:{_t_path_ms} key:{_t_key_ms} iv:{int(interval*1000)} 珥?{_t_iter_total}ms ({current_x},{current_y})??direction} [{boss_mode}]"
                    logger.info(f"[??대컢] {_timing_msg}")
                    if _ui_update_ok:
                        self.after(0, lambda m=_timing_msg: self._append_log(m))
                    last_dir = direction
                    prev_x, prev_y = current_x, current_y
                    continue
                # ?? 蹂댁뒪 ?섏쟾 ?몃뱾??????

                # A* 寃쎈줈?먯깋?쇰줈 諛⑺뼢 寃곗젙
                _t_path_start = time.time()
                direction = find_path_direction(current_x, current_y, target_x, target_y)
                _t_path_ms = int((time.time() - _t_path_start) * 1000)

                # A* 以?以묒? ?붿껌 諛쒖깮 ??利됱떆 猷⑦봽 ?덉텧
                if self._stop_event.is_set():
                    break

                if direction is None:
                    _t_iter_total = int((time.time() - _t_iter_start) * 1000)
                    _timing_msg = f"??#{iteration} OCR:{_t_ocr_ms} A*:{_t_path_ms} 珥?{_t_iter_total}ms ({current_x},{current_y}) 諛⑺뼢?놁쓬"
                    logger.info(f"[??대컢] {_timing_msg}")
                    if _ui_update_ok:
                        self.after(0, lambda m=_timing_msg: self._append_log(m))
                    if not self._stop_event.is_set() and _ui_update_ok:
                        self.after(0, lambda cx=current_x, cy=current_y:
                            self._append_log(f"??({cx},{cy}) 諛⑺뼢 ?놁쓬"))
                    if mapping_on and use_map and _is_mapping_mode:
                        _cleared_edge = 0
                        for _d in DIRECTIONS_4.keys():
                            _ek = _edge_key(current_x, current_y, _d)
                            if _ek in edge_blocked_moves:
                                edge_blocked_moves.pop(_ek, None)
                                _cleared_edge += 1
                        if _cleared_edge > 0:
                            self._special_diag(
                                "direction_none_relax_edge",
                                iter=iteration,
                                pos=f"{current_x},{current_y}",
                                edge_clear=_cleared_edge,
                            )
                            if not self._stop_event.is_set() and _ui_update_ok:
                                self.after(0, lambda cx=current_x, cy=current_y, ec=_cleared_edge:
                                    self._append_log(f"?㎛ 諛⑺뼢?놁쓬 李⑤떒?꾪솕: ({cx},{cy}) {ec}"))
                    self._stop_event.wait(0.1)
                    prev_x, prev_y = current_x, current_y
                    continue

                # UI ?낅뜲?댄듃
                # ?꾩갑醫뚰몴媛 ?щ윭 媛쒕㈃ 媛??媛源뚯슫 ?꾩갑醫뚰몴 湲곗??쇰줈 嫄곕━ 怨꾩궛
                _cur_re_dist = all_targets[target_idx][7] if len(all_targets[target_idx]) > 7 else []
                if _cur_re_dist:
                    dist = min(abs(ex - current_x) + abs(ey - current_y) for ex, ey in _cur_re_dist)
                else:
                    dist = abs(target_x - current_x) + abs(target_y - current_y)
                is_final = (target_idx == len(all_targets) - 1)
                slow_approach_dist = 2  # 紐⑤뱺 寃쎌쑀吏 N移??꾨???媛먯냽 (?ы깉 媛먯???
                is_slow = dist <= slow_approach_dist

                if not self._stop_event.is_set() and _ui_update_ok:
                    symbols = {"up": "??, "down": "??, "left": "??, "right": "??}
                    seg_name = all_targets[target_idx][2]
                    mode_text = "?맊 媛먯냽?묎렐" if is_slow else "?대룞以?
                    progress = f"[{target_idx+1}/{len(all_targets)}]"
                    self.after(0, lambda cx=current_x, cy=current_y, d=dist, s=symbols.get(direction, direction), tx=target_x, ty=target_y, m=mode_text, p=progress:
                        self._update_status(m, f"({cx},{cy})", f"({tx},{ty})", f"{d}移?{p}", s))

                # 寃쎌쑀吏 洹쇱젒 ??媛먯냽 (?ы깉 ??醫뚰몴 蹂寃??鍮?
                if is_slow:
                    if not self._stop_event.is_set() and _ui_update_ok:
                        self.after(0, lambda cx=current_x, cy=current_y, d=dist:
                            self._append_log(f"?맊 媛먯냽?묎렐 ({cx},{cy}) 嫄곕━:{d}移?))
                    self._stop_event.wait(0.05)

                if self._stop_event.is_set():
                    break

                # 諛⑺뼢???낅젰 吏곸쟾 ?꾩갑 ?щ? ?ы솗??(?대룞 以??꾩갑 媛??
                if dist <= 2:
                    _t_recheck = time.time()
                    check_x, check_y = matcher.read_both_coordinates(
                        self._config.coord_x_region,
                        self._config.coord_y_region,
                        stop_event=self._stop_event
                    )
                    _t_recheck_ms = int((time.time()-_t_recheck)*1000)
                    logger.info(f"[??대컢] #{iteration} ?꾩갑?ы솗?퇟CR: {_t_recheck_ms}ms")
                    if _ui_update_ok:
                        self.after(0, lambda m=_t_recheck_ms, i=iteration: self._append_log(f"??#{i} ?ы솗?퇟CR:{m}ms"))
                    if check_x is not None:
                        _cx, _cy = int(check_x), int(check_y)
                        # ?꾩갑醫뚰몴媛 ?щ윭 媛쒕㈃ ?대뒓 ?섎굹?쇰룄 ?쇱튂?섎㈃ ?꾩갑
                        if _cur_re_dist:
                            _check_arrived = any(_cx == ex and _cy == ey for ex, ey in _cur_re_dist)
                        else:
                            _check_arrived = (abs(_cx - target_x) + abs(_cy - target_y) == 0)
                        if _check_arrived:
                            # ?대? ?꾩갑! 諛⑺뼢???꾨Ⅴ吏 ?딄퀬 猷⑦봽濡?                            current_x, current_y = _cx, _cy
                            time.sleep(0.05)
                            continue

                # ?대룞 (?ы깉 洹쇱젒 ??吏㏃? ??쑝濡??ㅻ쾭?덊듃 諛⑹?)
                _t_key_start = time.time()
                if dist <= 1:
                    # ?ы깉 1移??? smooth_move 臾댁떆, 吏㏃? ??1?뚮쭔
                    key = self._config.move_keys.get(direction, direction)
                    _orig_pause = pyautogui.PAUSE
                    pyautogui.PAUSE = 0
                    try:
                        pyautogui.press(key)
                    finally:
                        pyautogui.PAUSE = _orig_pause
                    self._key_press_count += 1
                    if _ui_update_ok:
                        self.after(0, lambda: self._key_count_label.configure(text=f"{self._key_press_count}??))
                    self._stop_event.wait(0.2)  # ?ы깉 ?꾪솚 ?덉젙???湲?                else:
                    press_key(direction)
                _t_key_ms = int((time.time() - _t_key_start) * 1000)
                last_dir = direction
                prev_x, prev_y = current_x, current_y

                if is_slow and dist > 1:
                    self._stop_event.wait(0.05)

                # ??대컢 濡쒓렇 (留?諛섎났 ??UI + ?뚯씪)
                _t_iter_total = int((time.time() - _t_iter_start) * 1000)
                _timing_msg = f"??#{iteration} OCR:{_t_ocr_ms} sk:{_t_skill_ms} A*:{_t_path_ms} key:{_t_key_ms} iv:{int(interval*1000)} 珥?{_t_iter_total}ms ({current_x},{current_y})??direction} d={dist}"
                logger.info(f"[??대컢] {_timing_msg}")
                if _ui_update_ok:
                    self.after(0, lambda m=_timing_msg: self._append_log(m))

        except Exception as e:
            logger.error(f"[醫뚰몴紐⑤뱶] ?ㅻ쪟: {e}")
            self.after(0, lambda err=str(e): self._append_log(f"?좑툘 ?ㅻ쪟: {err}"))
        finally:
            # keyboard.remove_hotkey瑜?蹂꾨룄 ?ㅻ젅?쒖뿉???ㅽ뻾 (join ?놁씠 ??釉붾줈??諛⑹?)
            def _remove_hotkey():
                try:
                    keyboard.remove_hotkey(_escape_hotkey_id)
                except Exception:
                    pass
            threading.Thread(target=_remove_hotkey, daemon=True).start()

            try:
                self.after(0, self._stop_execution)
            except Exception:
                pass

    # pyautogui.PAUSE ?꾩뿭 ?곹깭 蹂댄샇????    _pyautogui_lock = threading.Lock()

    def _smooth_key_input_ui(self, keys, interval):
        """遺?쒕윭?????낅젰 (UI??"""
        import pyautogui

        with self._pyautogui_lock:
            original_pause = pyautogui.PAUSE
            pyautogui.PAUSE = 0
            try:
                start_time = time.time()
                while time.time() - start_time < interval and not self._stop_event.is_set():
                    self._key_press_count += 1
                    for key in keys:
                        pyautogui.keyDown(key)
                    time.sleep(0.015)  # 15ms ?꾨Ⅴ湲?                    for key in keys:
                        pyautogui.keyUp(key)
                    time.sleep(0.005)  # 5ms 媛꾧꺽
            finally:
                pyautogui.PAUSE = original_pause
        try:
            self.after(0, lambda: self._key_count_label.configure(text=f"{self._key_press_count}??))
        except (tk.TclError, RuntimeError):
            pass

    def _update_status(self, status, char, target, dist, direction, dx=None, dy=None):
        self._status_label.configure(text=f"?곹깭: {status}")
        self._char_pos_label.configure(text=char)
        self._target_pos_label.configure(text=target)
        self._distance_label.configure(text=dist)
        self._direction_label.configure(text=direction)
        self._key_count_label.configure(text=f"{self._key_press_count}??)

        # 濡쒓렇???곸꽭 ?뺣낫 異붽?
        if dx is not None and dy is not None:
            log_msg = f"[{status}] 罹먮┃??char} ??紐⑺몴{target} | dx={dx:+d} dy={dy:+d} | 嫄곕━={dist} | 諛⑺뼢={direction}"
            self._append_log(log_msg)

    _log_line_counter = 0

    def _is_special_diag_enabled(self) -> bool:
        """?뱁솕紐⑤뱶 吏꾨떒濡쒓렇 ?쒖꽦???щ?."""
        env_value = os.getenv("WINCRO_SPECIAL_DIAG", "").strip().lower()
        if env_value:
            return env_value not in {"0", "false", "off", "no"}
        return True

    def _special_diag(self, event: str, **fields):
        """?뱁솕紐⑤뱶 ?곸꽭 異붿쟻??援ъ“??濡쒓렇."""
        if not getattr(self, "_special_diag_enabled", False):
            return
        try:
            self._special_diag_seq = getattr(self, "_special_diag_seq", 0) + 1
            parts = [f"seq={self._special_diag_seq}", f"event={event}"]
            for key, value in fields.items():
                if isinstance(value, bool):
                    value = int(value)
                elif isinstance(value, float):
                    value = f"{value:.3f}"
                elif value is None:
                    value = "None"
                parts.append(f"{key}={str(value).replace(' ', '_')}")
            logger.info("[?뱁솕吏꾨떒] " + " ".join(parts))
        except Exception as e:
            logger.debug(f"[?뱁솕吏꾨떒] 濡쒓렇 ?앹꽦 ?ㅽ뙣: {e}")

    def _append_log(self, message: str, force: bool = False):
        """濡쒓렇 ?띿뒪?몄뿉 硫붿떆吏 異붽? (理쒕? 500以??쒗븳)"""
        try:
            if not force and self._stop_event.is_set():
                return
            from datetime import datetime
            timestamp = datetime.now().strftime("%H:%M:%S")
            self._log_text.configure(state="normal")
            self._log_text.insert("end", f"[{timestamp}] {message}\n")
            # 以???泥댄겕瑜?20?뚮쭏?ㅻ쭔 ?섑뻾 (?꾩젽 ?곗궛 ?덉빟)
            self._log_line_counter += 1
            if self._log_line_counter >= 20:
                self._log_line_counter = 0
                line_count = int(self._log_text.index("end-1c").split(".")[0])
                if line_count > 500:
                    self._log_text.delete("1.0", f"{line_count - 500}.0")
            self._log_text.see("end")
            self._log_text.configure(state="disabled")
        except Exception as e:
            logger.debug(f"臾댁떆???덉쇅: {e}")

    def _clear_log(self):
        """濡쒓렇 珥덇린??""
        try:
            self._log_text.configure(state="normal")
            self._log_text.delete("1.0", "end")
            self._log_text.configure(state="disabled")
            self._key_press_count = 0
            self._key_count_label.configure(text="0??)
        except Exception as e:
            logger.debug(f"臾댁떆???덉쇅: {e}")

    def _show_notification(self, title: str, message: str, duration: int = 3000):
        """鍮꾨툝濡쒗궧 ?뚮┝ (duration ms ???먮룞 ?ロ옒, 硫붿씤?ㅻ젅??釉붾줈???놁쓬)"""
        try:
            popup = ctk.CTkToplevel(self)
            popup.title(title)
            popup.geometry("350x150")
            popup.attributes("-topmost", True)
            popup.resizable(False, False)

            label = ctk.CTkLabel(popup, text=message, wraplength=300,
                                 font=ctk.CTkFont(size=14))
            label.pack(expand=True, padx=20, pady=20)

            close_btn = ctk.CTkButton(popup, text="?뺤씤", width=80,
                                       command=popup.destroy)
            close_btn.pack(pady=(0, 10))

            popup.after(duration, popup.destroy)
        except Exception:
            pass

    def _on_arrival(self):
        if not self._is_running:
            return  # 以묐났 ?몄텧 諛⑹?
        self._completed_normally = True  # ?뺤긽 ?꾩갑 ?뚮옒洹?        self._is_running = False
        self._stop_event.set()

        # --- ?쇰컲 ?꾨즺 泥섎━ ---
        self._run_btn.configure(text="???꾩껜 ?뚯뒪??, fg_color="#a3be8c")
        if hasattr(self, '_mapping_test_btn'):
            self._mapping_test_btn.configure(text="???꾩껜留듯븨?뚯뒪??, fg_color="#5e81ac")
        self._status_label.configure(text="?곹깭: ?꾨떖!", text_color="#a3be8c")
        self._append_log(f"?렞 紐⑺몴 ?꾨떖 ?꾨즺! 珥??ㅼ엯?? {self._key_press_count}??)
        # 媛쒕퀎 ?뚯뒪??移대뱶 踰꾪듉 蹂듭썝
        if getattr(self, '_single_waypoint_mode', False):
            single_idx = getattr(self, '_single_waypoint_idx', -1)
            if getattr(self, '_is_mapping_test', False) and single_idx >= 0:
                self._update_card_mapping_btn(single_idx, False)
            self._single_waypoint_mode = False
        self._is_mapping_test = False
        # ?꾩갑 ??留??곗씠?????(?쇰컲 ?뚯뒪?몄뿉?쒕뒗 嫄대꼫?)
        if not getattr(self, '_no_save_mode', False):
            if hasattr(self, '_game_map') and self._game_map:
                stats = self._game_map.get_statistics()
                if stats['total_tiles'] > 0:
                    threading.Thread(target=self._auto_save_map, daemon=True).start()
        self._show_notification("?꾨즺", f"紐⑺몴 ?꾨떖!\n珥????낅젰 ?잛닔: {self._key_press_count}??, duration=10000)

    def _build_coordinate_ui(self):
        """醫뚰몴 湲곕컲 紐⑤뱶 UI 援ъ꽦"""
        # === 寃쎌쑀吏 ?ㅼ젙 (紐⑺몴 醫뚰몴 ?듯빀) ===
        waypoint_frame = ctk.CTkFrame(self._coord_mode_frame, fg_color=COLORS["bg_card"], corner_radius=10)
        waypoint_frame.pack(fill="x", pady=(0, 8))
        waypoint_inner = ctk.CTkFrame(waypoint_frame, fg_color="transparent")
        waypoint_inner.pack(fill="x", padx=12, pady=10)

        ctk.CTkLabel(waypoint_inner, text="?뱧 寃쎌쑀吏 紐⑸줉",
                     font=ctk.CTkFont(size=12, weight="bold")).pack(anchor="w")
        ctk.CTkLabel(waypoint_inner, text="寃쎌쑀吏瑜??쒖꽌?濡??대룞?⑸땲??",
                     font=ctk.CTkFont(size=10), text_color=COLORS["text_secondary"]).pack(anchor="w", pady=(2, 8))

        # 寃쎌쑀吏 異붽? ?낅젰 (?대쫫留?
