                                                    self._appr_x_step = 0
                                                    self._appr_x_dir = 1  # 1=right, -1=left
                                                    self._appr_x_max = 2  # ??諛⑺뼢 理쒕? ?ㅽ뀦
                                                    if boss_skill_enabled and boss_skill_key:
