        result = {"saved": False}

        def save():
            def parse_float(entry):
                val = entry.get().strip().replace(',', '.')
                return float(val) if val else 0.0
            try:
                wait_val = parse_float(wait_entry)
                wait_range = parse_float(wait_range_entry)

