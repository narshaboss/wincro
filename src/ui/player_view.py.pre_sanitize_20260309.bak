            ctk.CTkLabel(row5, text=f"?? {_kn}",
                         font=ctk.CTkFont(size=10), text_color="#e8d090").pack(side="left", padx=(8, 0))

        # ?꾩젽 李몄“ ???(紐⑤뱺 踰꾪듉 ?ы븿)
        self._wp_cards.append({
