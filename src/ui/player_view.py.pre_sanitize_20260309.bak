        def _rebuild_path_index():
            """寃쎈줈 蹂寃?????ℓ???ш뎄異?(以묐났 醫뚰몴??泥??깆옣留??좎?)"""
            nonlocal path_pos_index
            path_pos_index = {}
            for i, pos in enumerate(current_path):
                if pos not in path_pos_index:
                    path_pos_index[pos] = i

        def _remember_recent_frontier(tile, reason: str, iter_value: int = None):
            """理쒓렐 ?꾨윴?곗뼱 紐⑸줉 愿由?(利됱떆 ?ъ꽑??諛⑹?)."""
            if tile is None:
                return
            if tile in recent_frontiers:
                recent_frontiers.remove(tile)
            recent_frontiers.append(tile)
            while len(recent_frontiers) > recent_frontier_limit:
                recent_frontiers.pop(0)
            if iter_value is not None:
                self._special_diag(
                    "frontier_recent",
                    iter=iter_value,
                    tile=f"{tile[0]},{tile[1]}",
                    reason=reason,
                    size=len(recent_frontiers),
                )

        _DIR_OPPOSITE = {"up": "down", "down": "up", "left": "right", "right": "left"}

        def _edge_key(x, y, direction):
            return (int(x), int(y), str(direction))

        def _opposite_dir(direction: str):
            return _DIR_OPPOSITE.get(direction)

        def _cleanup_expired_edge_blocks(iter_value: int):
            if not edge_blocked_moves:
                return 0
            expired = [k for k, until in edge_blocked_moves.items() if until <= iter_value]
            for k in expired:
                edge_blocked_moves.pop(k, None)
            return len(expired)

        def _is_edge_blocked(x, y, direction, iter_value: int = None) -> bool:
            if not direction:
                return False
            key = _edge_key(x, y, direction)
            until = edge_blocked_moves.get(key)
            if until is None:
                return False
            if iter_value is not None and until <= iter_value:
                edge_blocked_moves.pop(key, None)
                return False
            return True

        def _register_edge_block(from_x, from_y, direction, iter_value: int, ttl: int = None, reason: str = ""):
            nonlocal explored_from
            if not direction or direction not in DIRECTIONS_4:
                return
            ttl_value = EDGE_BLOCK_TTL_MIN if ttl is None else int(ttl)
            ttl_value = max(EDGE_BLOCK_TTL_MIN, min(EDGE_BLOCK_TTL_MAX, ttl_value))
            key = _edge_key(from_x, from_y, direction)
            until = iter_value + ttl_value
            prev_until = edge_blocked_moves.get(key, 0)
            if until > prev_until:
                edge_blocked_moves[key] = until
            src = (int(from_x), int(from_y))
            tried = explored_from.get(src, set())
            tried.add(direction)
            explored_from[src] = tried
            self._special_diag(
                "edge_block_registered",
                iter=iter_value,
                src=f"{src[0]},{src[1]}",
                dir=direction,
                until=edge_blocked_moves.get(key, until),
                reason=reason,
            )

        def _record_wall_fail_dir(tile, direction) -> int:
            if tile is None or not direction:
                return 0
            dirs = wall_fail_dirs.get(tile)
            if dirs is None:
                dirs = set()
                wall_fail_dirs[tile] = dirs
            dirs.add(direction)
            return len(dirs)

        def _clear_wall_fail_dir(tile):
            if tile is not None:
                wall_fail_dirs.pop(tile, None)

        def press_key(direction):
            """諛⑺뼢???꾨Ⅴ湲?""
            if self._stop_event.is_set():
                return
            _t_pk = time.time()
            key = self._config.move_keys.get(direction, direction)
            if smooth_move:
                self._smooth_key_input_ui([key], interval)
            else:
                # PAUSE=0 媛뺤젣 (rule_executor/action_player媛 0.1~0.3 ?ㅼ젙 ??press() 1?뚮떦 0.2~0.6珥???퉬 諛⑹?)
                _orig_pause = pyautogui.PAUSE
                pyautogui.PAUSE = 0
                try:
                    pyautogui.press(key)
                finally:
                    pyautogui.PAUSE = _orig_pause
                self._key_press_count += 1
                # 以묐떒 媛?ν븳 sleep
                sleep_until = time.time() + interval
                while time.time() < sleep_until:
                    if self._stop_event.is_set():
                        return
                    time.sleep(0.02)
            _t_pk_ms = int((time.time() - _t_pk) * 1000)
            logger.info(f"[??대컢] press_key: {_t_pk_ms}ms interval={interval} smooth={smooth_move}")

        def find_path_direction(cx, cy, tx, ty):
            """
            A* 寃쎈줈?먯깋 + ?먮룞 ?먯깋?쇰줈 ?ㅼ쓬 諛⑺뼢 寃곗젙
            1. ?뚮젮吏?寃쎈줈濡??먯깋
            2. 誘명깘???곸뿭 ?ы븿?댁꽌 ?먯깋
            3. ?ㅻ쭏???먯깋 (誘몄떆??諛⑺뼢 ?곗꽑)
            4. 鍮꾨꼍 諛⑺뼢 ?ъ떆??(諛깊듃?섑궧)
            5. 理쒗썑 吏곸쭊
            """
            nonlocal current_path, path_index, path_pos_index, explored_from, unknown_path_fails, _is_backtrack_dir

            _is_backtrack_dir = False
            current_pos = (cx, cy)
            target_pos = (tx, ty)
            if move_fail_avoid:
                _expired_avoid = [pos for pos, until in move_fail_avoid.items() if until <= iteration]
                for pos in _expired_avoid:
                    move_fail_avoid.pop(pos, None)
            _cleanup_expired_edge_blocks(iteration)
            _active_avoid_tiles = set(move_fail_avoid.keys())
            for _dir_name, (_adx, _ady) in DIRECTIONS_4.items():
                if _is_edge_blocked(cx, cy, _dir_name, iteration):
                    _active_avoid_tiles.add((cx + _adx, cy + _ady))

            # 寃쎈줈媛 ?덇퀬 ?꾩옱 ?꾩튂媛 寃쎈줈 ?곸뿉 ?덉쑝硫??곕씪媛湲?            if current_path and path_index < len(current_path):
                idx = path_pos_index.get(current_pos)
                if idx is not None:
                    path_index = idx
                    if path_index + 1 < len(current_path):
                        next_pos = current_path[path_index + 1]
                        # ?ㅼ쓬 ??쇱씠 踰??뚰봽?몃툝濡?異쒕컻吏?대㈃ 罹먯떆 臾댄슚????A* ?ш퀎??                        _is_start = (self._game_map.start_pos is not None and next_pos == self._game_map.start_pos)
                        if use_map and (_is_start or
                                        next_pos in _active_avoid_tiles or
                                        self._game_map.is_blocked(next_pos[0], next_pos[1]) or
                                        self._game_map.is_soft_blocked(next_pos[0], next_pos[1])):
                            current_path = []
                            path_index = 0
                            path_pos_index = {}
                        else:
                            dx = next_pos[0] - cx
                            dy = next_pos[1] - cy
                            for d, (ddx, ddy) in DIRECTIONS_4.items():
                                if ddx == dx and ddy == dy:
                                    if _is_edge_blocked(cx, cy, d, iteration):
                                        current_path = []
                                        path_index = 0
                                        path_pos_index = {}
                                        self._special_diag(
                                            "edge_block_skip_cached_path",
                                            iter=iteration,
                                            pos=f"{cx},{cy}",
                                            dir=d,
                                        )
                                        if _ui_update_ok:
                                            self.after(0, lambda px=cx, py=cy, d2=d:
                                                self._append_log(f"?㎛ 諛⑺뼢李⑤떒 ?뚰뵾: ({px},{py}) {d2}"))
                                        break
                                    remaining = len(current_path) - path_index - 1
                                    if _ui_update_ok:
                                        self.after(0, lambda d2=d, r=remaining:
                                            self._append_log(f"?슯 寃쎈줈異붿쟻 {d2} (?붿뿬:{r}移?"))
                                    return d

            _manhattan = abs(cx - tx) + abs(cy - ty)
            _skip_to_explore = False  # 理쒕떒寃쎈줈 紐⑤뱶 A* ?ㅽ뙣 ??True ??1李?2李?嫄대꼫?
            _adj_target_blocked_dir = None
            for _d_adj, (_ddx_adj, _ddy_adj) in DIRECTIONS_4.items():
                if cx + _ddx_adj == tx and cy + _ddy_adj == ty:
                    if _is_edge_blocked(cx, cy, _d_adj, iteration):
                        _adj_target_blocked_dir = _d_adj
                    break
            if _adj_target_blocked_dir is not None:
                _skip_to_explore = True
                _tried_now = explored_from.get(current_pos, set())
                _tried_now.add(_adj_target_blocked_dir)
                explored_from[current_pos] = _tried_now
                self._special_diag(
                    "adjacent_target_edge_blocked",
                    iter=iteration,
                    pos=f"{cx},{cy}",
                    target=f"{tx},{ty}",
                    dir=_adj_target_blocked_dir,
                )
                if _ui_update_ok:
                    self.after(0, lambda px=cx, py=cy, tx2=tx, ty2=ty, d2=_adj_target_blocked_dir:
                        self._append_log(f"?㎛ ?몄젒紐⑺몴 李⑤떒: ({px},{py})??{tx2},{ty2}) {d2} ?고쉶"))

            # ?? 留듯븨?뚯뒪??理쒕떒寃쎈줈 ?꾩슜 紐⑤뱶 ??????????????????????????
            # 留??곗씠??異⑸텇(50???) OR 異쒕컻醫뚰몴 ?녿뒗 留듯븨?뚯뒪??
            # allow_unknown A*濡?理쒕떒 寃쎈줈 (罹먮┃?곌? 留?諛뽰씠?대룄 誘몄? ?곸뿭 ?듦낵)
            # 踰?諛쒓껄 ??留?媛깆떊 ???ㅼ쓬 ?몄텧?먯꽌 A* ?ш퀎?????먯뿰 ?섎졃
            # ?ъ깮/?꾩껜?뚯뒪??遺遺꾩떎?됱? _is_mapping_test=False ???덈? 吏꾩엯 ????            if (not _skip_to_explore) and _is_mapping_test and (not full_mapping_exploring or _mt_has_map):
                _sp_result = pathfinder.find_path(
                    current_pos, target_pos, allow_unknown=True,
                    stop_event=self._stop_event,
                    allow_soft_blocked=False,
                    max_iterations=max(_manhattan * 30, 20000),
                    unknown_cost=3,
                    allow_avoid_goal=not _is_mapping_mode,
                    avoid_set=_active_avoid_tiles)  # 誘명깘??鍮꾩슜 3諛????뚮젮吏?寃쎈줈 ?곗꽑
                if self._stop_event.is_set():
                    return None
                if _sp_result.found and _sp_result.directions:
                    current_path = _sp_result.path
                    path_index = 0
                    _rebuild_path_index()
                    if _ui_update_ok:
                        self.after(0, lambda l=len(_sp_result.path):
                            self._append_log(f"?썶截?理쒕떒寃쎈줈: {l}移?))
                    return _sp_result.directions[0]
                # A* ?ㅽ뙣 (?щ갑 踰???洹밸떒??寃쎌슦) ??1李?2李?嫄대꼫?곌퀬 3李⑤줈 吏곹뻾
                _skip_to_explore = True

            # 1李?2李? ?쇰컲 紐⑤뱶 寃쎈줈 ?먯깋 (理쒕떒寃쎈줈 留듯븨 紐⑤뱶?먯꽌??嫄대꼫?)
            if not _skip_to_explore:
                # 1李? ?뚮젮吏??대룞媛??寃쎈줈留?(soft_blocked ?쒖쇅 ??源⑤걮???고쉶)
                # allow_unknown=False ???먯깋 踰붿쐞媛 ?뚮젮吏???쇰줈 ?쒖젙?섎?濡?max_iterations 遺덊븘??                result_clean = pathfinder.find_path(current_pos, target_pos, allow_unknown=False,
                                              stop_event=self._stop_event, allow_soft_blocked=False,
                                              allow_avoid_goal=not _is_mapping_mode,
                                              avoid_set=_active_avoid_tiles)
                if self._stop_event.is_set():
                    return None
                time.sleep(0)  # GIL ?댁젣 (Stage1 ??

                _max_clean = max(int(_manhattan * 5), 100)
                # ?뚮젮吏?寃쎈줈媛 留⑦빐???鍮?怨쇰룄?섍쾶 湲몃㈃ 誘명깘??吏곸꽑 寃쎈줈媛 ?섏쓣 ???덉쓬
                _known_too_long = (result_clean.found and len(result_clean.path) > max(_manhattan * 3, 30))

                if result_clean.found and len(result_clean.directions) > 0 and len(result_clean.path) <= _max_clean and not _known_too_long:
                    # 源⑤걮??寃쎈줈媛 ?⑸━??湲몄씠 ??諛붾줈 ?ъ슜
                    current_path = result_clean.path
                    path_index = 0
                    _rebuild_path_index()
                    unknown_path_fails = 0
                    if _ui_update_ok:
                        self.after(0, lambda l=len(result_clean.path): self._append_log(f"?썶截?寃쎈줈 諛쒓껄: {l}移?))
                    return result_clean.directions[0]

                time.sleep(0)  # GIL ?댁젣 (Stage1.5 ??
                # 1.5李? soft_blocked ?ы븿 (?고쉶濡??녾굅??1李?寃쎈줈媛 ?덈Т 湲???
                result = None
                if not _is_mapping_mode:
                    result = pathfinder.find_path(current_pos, target_pos, allow_unknown=False,
                                                  stop_event=self._stop_event, allow_soft_blocked=True,
                                                  allow_avoid_goal=not _is_mapping_mode,
                                                  avoid_set=_active_avoid_tiles)
                    if self._stop_event.is_set():
                        return None
                # 1.5李?寃곌낵 以?best known path ?좏깮
                _best_known = None
                if result is not None and result.found and len(result.directions) > 0:
                    if result_clean.found and len(result.path) >= len(result_clean.path):
                        _best_known = result_clean
                    else:
                        _best_known = result
                elif result_clean.found and len(result_clean.directions) > 0:
                    _best_known = result_clean

                # 2李? 誘명깘???곸뿭 ?ы븿 寃쎈줈 ?쒕룄
                # 留듯븨?뚯뒪???꾩껜留듯븨?먯꽌???ъ슜 ????(?ъ슜???ㅼ젙 踰?二쇰? 誘명깘???곸뿭 ?섎せ 吏꾩엯 諛⑹?)
                # 議곌굔: (1) known 寃쎈줈 ?놁쓬, (2) known 寃쎈줈媛 留⑦빐???鍮?怨쇰룄?섍쾶 源, (3) ?곗냽 ?ㅽ뙣 < 3
                _try_unknown = (not _is_mapping_mode and unknown_path_fails < 3 and
                                (_best_known is None or len(_best_known.path) > max(_manhattan * 3, 30)))
                _result_unknown = None
                if _try_unknown:
                    time.sleep(0)  # GIL ?댁젣 (Stage2 ??
                    _result_unknown = pathfinder.find_path(current_pos, target_pos, allow_unknown=True,
                                                           stop_event=self._stop_event,
                                                           max_iterations=max(_manhattan * 30, 20000),
                                                           unknown_cost=3,
                                                           allow_avoid_goal=not _is_mapping_mode,
                                                           avoid_set=_active_avoid_tiles)  # 誘명깘??鍮꾩슜 3諛????뚮젮吏?寃쎈줈 ?곗꽑
                    if self._stop_event.is_set():
                        return None
                    if _result_unknown.found and len(_result_unknown.directions) > 0:
                        _max_path = max(int(_manhattan * 5), 100)
                        if len(_result_unknown.path) > _max_path:
                            if _ui_update_ok:
                                self.after(0, lambda l=len(_result_unknown.path), m=_max_path:
                                    self._append_log(f"?좑툘 ?고쉶 {l}移?> 理쒕? {m}移????ㅽ궢"))
                            unknown_path_fails += 1
                            _result_unknown = None
                    else:
                        _result_unknown = None

                # 理쒖쥌 ?좏깮: known vs unknown 以?吏㏃? 寃쎈줈
                if _best_known and _result_unknown:
                    if len(_result_unknown.path) < len(_best_known.path):
                        # 誘명깘??寃쎈줈媛 ??吏㏃쓬 ??吏곸꽑?쇰줈 ?쒕룄
                        current_path = _result_unknown.path
                        path_index = 0
                        _rebuild_path_index()
                        if _ui_update_ok:
                            self.after(0, lambda l=len(_result_unknown.path), kl=len(_best_known.path):
                                self._append_log(f"?뵇 吏곸꽑 寃쎈줈: {l}移?(湲곗〈 ?고쉶 {kl}移?"))
                        return _result_unknown.directions[0]
                    else:
                        # ?뚮젮吏?寃쎈줈媛 ??吏㏐굅??媛숈쓬
                        current_path = _best_known.path
                        path_index = 0
                        _rebuild_path_index()
                        unknown_path_fails = 0
                        _label = "?꾩떆踰??듦낵" if (result is not None and _best_known is result) else "寃쎈줈"
                        if _ui_update_ok:
                            self.after(0, lambda l=len(_best_known.path), lb=_label: self._append_log(f"?썶截?{lb} 諛쒓껄: {l}移?))
                        return _best_known.directions[0]
                elif _best_known:
                    current_path = _best_known.path
                    path_index = 0
                    _rebuild_path_index()
                    unknown_path_fails = 0
                    if _ui_update_ok:
                        self.after(0, lambda l=len(_best_known.path): self._append_log(f"?썶截?寃쎈줈 諛쒓껄: {l}移?))
                    return _best_known.directions[0]
                elif _result_unknown:
                    current_path = _result_unknown.path
                    path_index = 0
                    _rebuild_path_index()
                    if _ui_update_ok:
                        self.after(0, lambda l=len(_result_unknown.path): self._append_log(f"?뵇 ?먯깋 寃쎈줈: {l}移?(誘몄? ?곸뿭 ?ы븿)"))
                    return _result_unknown.directions[0]

            # 3李? ?ㅻ쭏???먯깋 ???꾩옱 ?꾩튂?먯꽌 ?꾩쭅 ??媛蹂?諛⑺뼢 ?쒕룄
            _start_pos = self._game_map.start_pos
            tried = explored_from.get(current_pos, set())
            candidates = []
            for d, (ddx, ddy) in DIRECTIONS_4.items():
                nx, ny = cx + ddx, cy + ddy
                if d not in tried and not self._game_map.is_blocked(nx, ny):
                    if _is_edge_blocked(cx, cy, d, iteration):
                        continue
                    if _start_pos is not None and (nx, ny) == _start_pos:
                        continue  # 異쒕컻吏 ?뚰뵾
                    dist = abs(nx - tx) + abs(ny - ty)
                    revisit = visit_counts.get((nx, ny), 0)
                    reverse_penalty = 3 if _opposite_dir(last_dir) == d else 0
                    score = dist + min(revisit, 8) * 2 + reverse_penalty
                    candidates.append((score, revisit, d))

            if candidates:
                candidates.sort()
                chosen = candidates[0][2]
                tried.add(chosen)
                explored_from[current_pos] = tried
                if _ui_update_ok:
                    self.after(0, lambda d=chosen: self._append_log(f"?뵇 ?먯깋: {d}"))
                return chosen

            # 4李? ?대? ?쒕룄?덉?留?踰쎌씠 ?꾨땶 諛⑺뼢 ?ъ떆??(諛깊듃?섑궧)
            _is_backtrack_dir = True
            # 理쒓렐 諛⑸Ц ?꾩튂 ?뚰뵾 + 諛섎났 媛먯? ??踰??댁젣
            recent_positions.append((cx, cy))
            if len(recent_positions) > 20:
                recent_positions.pop(0)

            # 諛섎났 媛먯?: 理쒓렐 10??以?媛숈? ?꾩튂 5???댁긽 ???몄젒 踰??댁젣
            if len(recent_positions) >= 10:
                from collections import Counter
                pos_counts = Counter(recent_positions[-10:])
                most_common_count = pos_counts.most_common(1)[0][1]
                if most_common_count >= 5:
                    if _is_mapping_mode:
                        self._special_diag(
                            "wall_unblock_skip_mapping",
                            iter=iteration,
                            trigger="repeat_detect",
                            pos=f"{cx},{cy}",
                            repeat=most_common_count,
                        )
                    else:
                        unblocked = 0
                        for d2, (ddx2, ddy2) in DIRECTIONS_4.items():
                            nb = (cx + ddx2, cy + ddy2)
                            if nb in _portal_protected:
                                continue  # ?ы깉 醫뚰몴 蹂댄샇
                            if self._game_map.is_blocked(nb[0], nb[1]):
                                self._game_map.mark_passable(nb[0], nb[1])
                                unblocked += 1
                            elif self._game_map.is_soft_blocked(nb[0], nb[1]):
                                self._game_map.mark_passable(nb[0], nb[1])
                                unblocked += 1
                        if unblocked > 0:
                            if _ui_update_ok:
                                self.after(0, lambda u=unblocked, cx2=cx, cy2=cy:
                                    self._append_log(f"?뵑 諛섎났媛먯?({cx2},{cy2}) ??{u}媛??몄젒踰??댁젣"))
                            recent_positions.clear()
                            # ?꾩옱 ?꾩튂??explored_from 珥덇린??(?댁젣??踰?諛⑺뼢 ?ъ떆???덉슜)
                            explored_from.pop(current_pos, None)
                            current_path = []
                            path_index = 0
                            path_pos_index = {}
                            # return None ?쒓굅: 踰??댁젣 ???꾨옒 諛깊듃?섑궧?쇰줈 利됱떆 諛⑺뼢 寃곗젙

            # 理쒓렐 諛⑸Ц ?꾩튂瑜??쇳빐??諛깊듃?섑궧
            recent_set = set(recent_positions[-6:]) | set(recent_valid_coords[-8:])
            tried_dirs = explored_from.get((cx, cy), set())
            backtrack_candidates = []
            for d, (ddx, ddy) in DIRECTIONS_4.items():
                nx, ny = cx + ddx, cy + ddy
                if _start_pos is not None and (nx, ny) == _start_pos:
                    continue  # 異쒕컻吏 ?뚰뵾
                if _is_edge_blocked(cx, cy, d, iteration):
                    continue
                if not self._game_map.is_blocked(nx, ny) and not self._game_map.is_soft_blocked(nx, ny):
                    backtrack_candidates.append((d, (nx, ny)))
            if backtrack_candidates:
                backtrack_candidates.sort(
                    key=lambda x: (
                        visit_counts.get(x[1], 0),
                        2 if _opposite_dir(last_dir) == x[0] else 0,
                        abs(x[1][0] - tx) + abs(x[1][1] - ty),
                    )
                )
            if backtrack_candidates:
                # ?대? ?ㅽ뙣??諛⑺뼢 ?쒖쇅 + 理쒓렐 諛⑸Ц ????怨??곗꽑
                for d, pos in backtrack_candidates:
                    if d not in tried_dirs and pos not in recent_set and d != last_dir:
                        if _ui_update_ok:
                            self.after(0, lambda d2=d: self._append_log(f"???섎룎?꾧?湲?({d2})"))
                        return d
                # ?ㅽ뙣 諛⑺뼢 ?쒖쇅留?                for d, pos in backtrack_candidates:
                    if d not in tried_dirs and d != last_dir:
                        if _ui_update_ok:
                            self.after(0, lambda d2=d: self._append_log(f"???섎룎?꾧?湲?({d2})"))
                        return d
                # ?ㅽ뙣 諛⑺뼢肉먯씠硫?理쒓렐 諛⑸Ц ????怨녹씠?쇰룄
                for d, pos in backtrack_candidates:
                    if pos not in recent_set:
                        if _ui_update_ok:
                            self.after(0, lambda d2=d: self._append_log(f"???섎룎?꾧?湲?({d2})"))
                        return d
                # ?꾨? ?ㅽ뙣 諛⑺뼢肉먯씠硫??댁찓 ???놁씠 ?ъ슜
                if _ui_update_ok:
                    self.after(0, lambda d2=backtrack_candidates[0][0]: self._append_log(f"???섎룎?꾧?湲?({d2})"))
                return backtrack_candidates[0][0]

            # 5李? ?щ갑??踰?(吏꾩쭨 留됰떎瑜?湲? ??諛⑺뼢 ?쒗솚 ?쒕룄
            if _ui_update_ok:
                self.after(0, lambda: self._append_log("?좑툘 留됰떎瑜?湲?"))
            dirs = list(DIRECTIONS_4.keys())  # [up, down, left, right]
            tried_dirs = explored_from.get((cx, cy), set())
            deadend_recent = set(recent_valid_coords[-8:]) | set(recent_positions[-8:])
            # 吏곸쟾 ?ㅽ뙣 諛⑺뼢 + 怨쇰떎 諛⑸Ц 移??뚰뵾
            fallback_candidates = []
            for offset in range(1, 5):
                d = dirs[(iteration + offset) % 4]
                ddx, ddy = DIRECTIONS_4.get(d, (0, 0))
                nx, ny = cx + ddx, cy + ddy
                if _start_pos is not None and (nx, ny) == _start_pos:
                    continue
                if _is_edge_blocked(cx, cy, d, iteration):
                    continue
                if self._game_map.is_blocked(nx, ny):
                    continue
                revisit = visit_counts.get((nx, ny), 0)
                turn_penalty = 1 if d == last_dir else 0
                reverse_penalty = 4 if _opposite_dir(last_dir) == d else 0
                tried_penalty = 3 if d in tried_dirs else 0
                recent_penalty = 2 if (nx, ny) in deadend_recent else 0
                score = revisit + turn_penalty + reverse_penalty + tried_penalty + recent_penalty
                fallback_candidates.append((score, revisit, d))
            if fallback_candidates:
                fallback_candidates.sort()
                self._special_diag(
                    "dead_end_pick",
                    iter=iteration,
                    pos=f"{cx},{cy}",
                    dir=fallback_candidates[0][2],
                    score=fallback_candidates[0][0],
                    revisit=fallback_candidates[0][1],
                    cands=len(fallback_candidates),
                )
                return fallback_candidates[0][2]
            # 紐⑤뱺 諛⑺뼢??edge-block?쇰줈 ?좉꺼 硫덉텛??寃쎌슦: ??쇱? ?좎??섍퀬 ?꾩옱 移몄쓽 諛⑺뼢李⑤떒留??꾪솕
            relax_candidates = []
            for d, (ddx, ddy) in DIRECTIONS_4.items():
                nx, ny = cx + ddx, cy + ddy
                if _start_pos is not None and (nx, ny) == _start_pos:
                    continue
                if self._game_map.is_blocked(nx, ny) or self._game_map.is_soft_blocked(nx, ny):
                    continue
                _until = edge_blocked_moves.get(_edge_key(cx, cy, d), 0)
                _remaining = max(0, _until - iteration)
                _revisit = visit_counts.get((nx, ny), 0)
                _reverse = 1 if _opposite_dir(last_dir) == d else 0
                relax_candidates.append((_remaining, _revisit, _reverse, d))
            if relax_candidates:
                relax_candidates.sort()
                chosen = relax_candidates[0][3]
                _chosen_key = _edge_key(cx, cy, chosen)
                _had_block = _chosen_key in edge_blocked_moves
                if _had_block:
                    edge_blocked_moves.pop(_chosen_key, None)
                self._special_diag(
                    "dead_end_relax_edge",
                    iter=iteration,
                    pos=f"{cx},{cy}",
                    dir=chosen,
                    had_block=int(_had_block),
                    remain=relax_candidates[0][0],
                    revisit=relax_candidates[0][1],
                )
                if _ui_update_ok:
                    self.after(0, lambda px=cx, py=cy, d2=chosen:
                        self._append_log(f"?㎛ 留됰떎瑜멸만 ?꾪솕: ({px},{py}) {d2} ?ъ떆??))
                return chosen
            self._special_diag(
                "dead_end_no_candidate",
                iter=iteration,
                pos=f"{cx},{cy}",
            )
            return None

        frontier_cooldown = set()  # 理쒓렐 ?꾨떖/臾댄슚?붾맂 ?꾨윴?곗뼱 (?ъ꽑??諛⑹?)
        frontier_cooldown_iter = 0  # 荑⑤떎??由ъ뀑 湲곗? 諛섎났

        def _find_nearest_frontier(cx, cy, max_radius=150, explore_center=None, explore_radius=0,
                                   skip_recent=False, ignore_cooldown=False):
            """媛??媛源뚯슫 frontier 李얘린 (BFS - 媛源뚯슫 寃껊????먯깋)
            explore_center/explore_radius: 洹쇱쿂留듯븨 ??誘명깘???댁썐??諛섍꼍 ?댁뿬???꾨줎?곗뼱 ?먯젙
            """
            from collections import deque
            _delta_to_dir = {(0, -1): "up", (0, 1): "down", (-1, 0): "left", (1, 0): "right"}
            _start_pos = self._game_map.start_pos
            visited = {(cx, cy)}
            queue = deque([(cx, cy, 0)])
            _fnf_iter = 0
            while queue:
                _fnf_iter += 1
                if _fnf_iter % 100 == 0:
                    time.sleep(0)  # GIL ?댁젣
                px, py, dist = queue.popleft()
                if dist > max_radius:  # 理쒕? ?먯깋 嫄곕━
                    break
                # frontier 泥댄겕 (explore_unreachable? ?꾨윴?곗뼱 諛섑솚留??ㅽ궢, ?댁썐 ?뺤옣? ?덉슜)
                if (px, py) not in explore_unreachable:
                    if (px, py) in self._game_map.passable:
                        if ignore_cooldown or (px, py) not in frontier_cooldown:
                            if skip_recent and (px, py) in recent_frontiers:
                                continue
                            _ef = explored_from.get((px, py), set())
                            for ddx, ddy in [(0, -1), (0, 1), (-1, 0), (1, 0)]:
                                nx, ny = px + ddx, py + ddy
                                if not self._game_map.is_known(nx, ny):
                                    # 洹쇱쿂留듯븨: 誘명깘???댁썐??諛섍꼍 諛뽰씠硫??꾨줎?곗뼱 ?먯젙 ?쒖쇅
                                    if explore_center is not None:
                                        _ed = max(abs(nx - explore_center[0]), abs(ny - explore_center[1]))
                                        if _ed > explore_radius:
                                            continue
                                    # ?대? ?쒕룄+?ㅽ뙣??諛⑺뼢? frontier ?먯젙?먯꽌 ?쒖쇅
                                    if _delta_to_dir.get((ddx, ddy)) in _ef:
                                        continue
                                    return (px, py)
                # ?몄젒 ????먯깋 (passable留? start_pos ?쒖쇅 ??A* ?쇨???
                for ddx, ddy in [(0, -1), (0, 1), (-1, 0), (1, 0)]:
                    nx, ny = px + ddx, py + ddy
                    if (nx, ny) not in visited and (nx, ny) in self._game_map.passable:
                        if _start_pos is None or (nx, ny) != _start_pos:
                            visited.add((nx, ny))
                            queue.append((nx, ny, dist + 1))
            return None

        def _count_frontier_tiles(explore_center=None, explore_radius=0, include_unreachable=True):
            """?꾩옱 留듭뿉??誘명깘???댁썐???⑥? ?꾨윴?곗뼱 ?????"""
            count = 0
            for px, py in self._game_map.passable:
                if (not include_unreachable) and ((px, py) in explore_unreachable):
                    continue
                has_unknown = False
                for ddx, ddy in [(0, -1), (0, 1), (-1, 0), (1, 0)]:
                    nx, ny = px + ddx, py + ddy
                    if self._game_map.is_known(nx, ny):
                        continue
                    if explore_center is not None:
                        _ed = max(abs(nx - explore_center[0]), abs(ny - explore_center[1]))
                        if _ed > explore_radius:
                            continue
                    has_unknown = True
                    break
                if has_unknown:
                    count += 1
            return count

        try:
            # 寃뚯엫 李??꾪솚 ?湲???stop_event ?ㅼ뿼 諛⑹? ?꾪빐 吏곸쟾 ?ы겢由ъ뼱
            if self._stop_event.is_set():
                logger.warning("[醫뚰몴紐⑤뱶] 2珥??湲???stop_event媛 ?대? set ???ы겢由ъ뼱")
                self._stop_event.clear()
            # stop_event.wait ?ъ슜 ??以묒? 利됱떆 諛섏쓳 (time.sleep ???
            if self._stop_event.wait(2.0):
                self.after(0, lambda: self._append_log("?좑툘 2珥??湲?以?以묒? 媛먯?"))
                self.after(0, self._stop_execution)
                return

            iteration = 0
            max_iterations = 50000 if _is_mapping_mode else 5000
            coord_fail_count = 0
            max_coord_fails = 50  # ?곗냽 50???ㅽ뙣 ??以묐떒
            while not self._stop_event.is_set() and iteration < max_iterations:
                iteration += 1
                _ui_update_ok = (iteration % 10 == 0)  # UI ?낅뜲?댄듃??10?뚮떦 1踰?(Tkinter ????＜ 諛⑹?)
                _t_iter_start = time.time()
                if _mt_map_recording_frozen:
                    mapping_on = False
                    _is_mapping_mode = False

                # 以묒? ?뺤씤 (醫뚰몴 ?쎄린 ??利됱떆 泥댄겕)
                if self._stop_event.is_set():
                    break

                # 醫뚰몴 ?쎄린 (stop_event ?꾨떖 ??以묒? ??利됱떆 諛섑솚)
                _t_ocr_start = time.time()
                current_x, current_y = matcher.read_both_coordinates(
                    self._config.coord_x_region,
                    self._config.coord_y_region,
                    "X", "Y",
                    stop_event=self._stop_event
                )
                _t_ocr_ms = int((time.time() - _t_ocr_start) * 1000)

                # 醫뚰몴 ?쎄린 ??以묒? ?ы솗??                if self._stop_event.is_set():
                    break

                if current_x is None or current_y is None:
                    coord_fail_count += 1
                    self._special_diag(
                        "ocr_fail",
                        iter=iteration,
                        fail=coord_fail_count,
                        fail_max=max_coord_fails,
                        ocr_ms=_t_ocr_ms,
                    )
                    if coord_fail_count >= max_coord_fails:
                        self.after(0, lambda: self._append_log(f"??醫뚰몴 ?쎄린 ?곗냽 {max_coord_fails}???ㅽ뙣 ??以묐떒"))
                        self.after(0, self._stop_execution)
                        return
                    if coord_fail_count % 5 == 1:
                        self.after(0, lambda c=coord_fail_count: self._append_log(f"?좑툘 醫뚰몴 ?쎄린 ?ㅽ뙣 ({c}/{max_coord_fails})"))
                    if _ui_update_ok:
                        self.after(0, lambda: self._status_label.configure(text="醫뚰몴 ?쎄린 ?ㅽ뙣"))
                    self._stop_event.wait(0.1)
                    continue

                coord_fail_count = 0  # ?깃났 ??由ъ뀑
                # 醫뚰몴瑜??뺤닔濡??뺤떎?섍쾶 蹂??                current_x = int(current_x)
                current_y = int(current_y)
                _visit_key = (current_x, current_y)
                visit_counts[_visit_key] = visit_counts.get(_visit_key, 0) + 1
                if visit_counts[_visit_key] in (10, 20, 35):
                    self._special_diag(
                        "visit_hotspot",
                        iter=iteration,
                        tile=f"{current_x},{current_y}",
                        visits=visit_counts[_visit_key],
                    )
                if iteration % 25 == 0:
                    self._special_diag(
                        "loop_snapshot",
                        iter=iteration,
                        cur=f"{current_x},{current_y}",
                        prev=f"{prev_x},{prev_y}",
                        target=f"{target_x},{target_y}",
                        stuck=stuck_count,
                        total_stuck=total_stuck_count,
                        unknown_fails=unknown_path_fails,
                        path_len=len(current_path or []),
                        path_idx=path_index,
                        last_dir=last_dir,
                        boss_mode=boss_mode,
                    )

                # 醫뚰몴 踰붿쐞 寃利?(OCR ?ㅻ룆 ?꾪꽣留?
                # 1) ?덈? 踰붿쐞: 500 珥덇낵 臾댁떆
                if abs(current_x) > 500 or abs(current_y) > 500:
                    self._special_diag("ocr_range_reject", iter=iteration, cur=f"{current_x},{current_y}")
                    if iteration % 10 == 1:
                        self.after(0, lambda cx=current_x, cy=current_y:
                            self._append_log(f"?좑툘 醫뚰몴 踰붿쐞 珥덇낵 臾댁떆: ({cx},{cy})"))
                    self._stop_event.wait(0.1)
                    continue
                # 1.5) 理쒓렐 醫뚰몴 湲곕컲 ?댁긽移??꾪꽣 (?ы깉/?붾젅?ы듃 吏곹썑???쒖쇅)
                _skip_sanity_guard = (portal_grace > 0 or mark_portal_entry or boss_pre_teleport)
                if not _skip_sanity_guard and len(recent_valid_coords) >= 6:
                    _sample = recent_valid_coords[-10:]
                    _mx = sorted(x for x, _ in _sample)[len(_sample) // 2]
                    _my = sorted(y for _, y in _sample)[len(_sample) // 2]
                    _mjump = abs(current_x - _mx) + abs(current_y - _my)
                    if _mjump >= 80:
                        self._special_diag(
                            "ocr_median_reject",
                            iter=iteration,
                            cur=f"{current_x},{current_y}",
                            median=f"{_mx},{_my}",
                            dist=_mjump,
                        )
                        if iteration % 8 == 0:
                            self.after(0, lambda cx=current_x, cy=current_y, mx=_mx, my=_my:
                                self._append_log(f"?좑툘 醫뚰몴 ?댁긽移?臾댁떆: ({cx},{cy}) median=({mx},{my})"))
                        self._stop_event.wait(0.05)
                        continue
                if not _skip_sanity_guard and mapping_on and use_map and len(self._game_map.passable) >= 80:
                    _mb = self._game_map.get_bounds()
                    _margin = 30 if _is_mapping_mode else 45
                    if (current_x < _mb["min_x"] - _margin or current_x > _mb["max_x"] + _margin or
                            current_y < _mb["min_y"] - _margin or current_y > _mb["max_y"] + _margin):
                        self._special_diag(
                            "ocr_bounds_reject",
                            iter=iteration,
                            cur=f"{current_x},{current_y}",
                            bounds=f"{_mb['min_x']},{_mb['max_x']},{_mb['min_y']},{_mb['max_y']}",
                            margin=_margin,
                        )
                        if iteration % 8 == 0:
                            self.after(0, lambda cx=current_x, cy=current_y:
                                self._append_log(f"?좑툘 醫뚰몴 寃쎄퀎 ?댄깉 臾댁떆: ({cx},{cy})"))
                        self._stop_event.wait(0.05)
                        continue
                # 1.6) (0,0) OCR ?ㅽ깘 ?꾪꽣 (留듯븨 以?留??ㅼ뿼 諛⑹?)
                if (current_x, current_y) == (0, 0) and portal_grace <= 0:
                    _route_ends_now = all_targets[target_idx][7] if len(all_targets[target_idx]) > 7 else []
                    _route_starts_now = all_targets[target_idx][8] if len(all_targets[target_idx]) > 8 else []
                    _zero_allowed = (
                        (target_x, target_y) == (0, 0)
                        or (0, 0) in _route_ends_now
                        or (0, 0) in _route_starts_now
                    )
                    _prev_far_from_zero = (prev_x is not None and (abs(prev_x) + abs(prev_y) >= 8))
                    if mapping_on and use_map and len(self._game_map.passable) >= 80 and _prev_far_from_zero and not _zero_allowed:
                        self._special_diag(
                            "ocr_zero_reject",
                            iter=iteration,
                            prev=f"{prev_x},{prev_y}",
                            cur="0,0",
                            target=f"{target_x},{target_y}",
                        )
                        if iteration % 5 == 0:
                            self.after(0, lambda px=prev_x, py=prev_y:
                                self._append_log(f"?좑툘 醫뚰몴 ?ㅽ깘 臾댁떆: (0,0) prev=({px},{py})"))
                        self._stop_event.wait(0.05)
                        continue
                # 2) ?댁쟾 醫뚰몴 ?鍮??먰봽 嫄곕━: 30移??댁긽?대㈃ OCR ?ㅻ룆 ?섏떖
                if portal_grace > 0:
                    portal_grace -= 1
                    _jump_reject_coord = None
                    _jump_reject_count = 0
                    # ?ы깉 ?꾪솚 ??醫뚰몴 ?덉젙?? 濡쒕뵫 以??섎せ??醫뚰몴濡?異쒕컻吏 ?깅줉?먯쑝硫?援먯젙
                    if _pending_start_pos is not None and mapping_on and use_map:
                        dist_from_pending = abs(current_x - _pending_start_pos[0]) + abs(current_y - _pending_start_pos[1])
                        if dist_from_pending >= 5:
                            if dist_from_pending > 80:
                                self._special_diag(
                                    "portal_start_reject_far",
                                    iter=iteration,
                                    pending=f"{_pending_start_pos[0]},{_pending_start_pos[1]}",
                                    cur=f"{current_x},{current_y}",
                                    dist=dist_from_pending,
                                )
                                if iteration % 5 == 0:
                                    self.after(0, lambda cx=current_x, cy=current_y:
                                        self._append_log(f"?좑툘 ?ы깉援먯젙 醫뚰몴 臾댁떆(嫄곕━ 怨쇰떎): ({cx},{cy})"))
                                self._stop_event.wait(0.05)
                                continue
                            old_sp = _pending_start_pos
                            _pending_start_pos = (current_x, current_y)
                            self._game_map.start_pos = _pending_start_pos
                            self._game_map.mark_blocked(current_x, current_y)
                            # start_pos ?낅뜲?댄듃 ???댁쟾 ?꾩튂瑜?passable濡?蹂寃?(誘명깘???곹깭 諛⑹?)
                            if old_sp not in _portal_protected:
                                self._game_map.mark_passable(old_sp[0], old_sp[1])
                            self.after(0, lambda ox=old_sp[0], oy=old_sp[1], cx=current_x, cy=current_y:
                                self._append_log(f"?봽 異쒕컻吏 援먯젙: ({ox},{oy})??{cx},{cy})"))
                    # portal_grace 留뚮즺 ??援먯젙 醫낅즺
                    if portal_grace == 0:
                        _pending_start_pos = None
                elif prev_x is not None:
                    jump = abs(current_x - prev_x) + abs(current_y - prev_y)
                    if jump >= 30:
                        # 紐⑺몴 洹쇱젒(1移??대궡)?먯꽌 ?먰봽 ???ы깉 ?꾪솚, 李⑤떒 ????                        # ?꾩갑醫뚰몴媛 ?щ윭 媛쒕㈃ ?대뒓 ?섎굹?쇰룄 洹쇱젒?섎㈃ ?덉슜 (?ы깉 媛먯?? ?숈씪 濡쒖쭅)
                        was_near = abs(prev_x - target_x) + abs(prev_y - target_y) <= 1
                        if not was_near:
                            _jf_re = all_targets[target_idx][7] if len(all_targets[target_idx]) > 7 else []
                            if _jf_re:
                                was_near = any(abs(prev_x - ex) + abs(prev_y - ey) <= 1 for ex, ey in _jf_re)
                        self._special_diag(
                            "ocr_jump_detected",
                            iter=iteration,
                            prev=f"{prev_x},{prev_y}",
                            cur=f"{current_x},{current_y}",
                            jump=jump,
                            was_near=was_near,
                            mark_portal_entry=mark_portal_entry,
                            boss_pre_teleport=boss_pre_teleport,
                        )
                        # ?ы깉 ?꾪솚 以묒씠硫??덉슜 (mark_portal_entry, boss_pre_teleport, 紐⑺몴 洹쇱젒)
                        if not mark_portal_entry and not boss_pre_teleport and not was_near:
                            # 留듯븨?뚯뒪???꾩껜留듯븨: 30移? ?먰봽???ы깉濡?泥섎━ (踰??깅줉 + 以묒?)
                            if _is_mapping_mode and mapping_on and use_map:
                                if last_dir:
                                    _pdx, _pdy = DIRECTIONS_4.get(last_dir, (0, 0))
                                    _portal_tile = (prev_x + _pdx, prev_y + _pdy)
                                    self._game_map.mark_blocked(_portal_tile[0], _portal_tile[1])
                                    _portal_protected.add(_portal_tile)
                                    self.after(0, lambda pt=_portal_tile, cx=current_x, cy=current_y, px=prev_x, py=prev_y:
                                        self._append_log(f"?슞 留듯븨 以??ы깉 媛먯?: ({px},{py})??{cx},{cy}) ??{pt} 踰??깅줉"))
                                # 留듯븨 以??ы깉: 踰??깅줉 ???먯깋 怨꾩냽 (以묒? ????
                                self._game_map.mark_passable(current_x, current_y)
                                current_path = []
                                stuck_count = 0
                                last_dir = None
                                prev_x, prev_y = current_x, current_y  # ?ы깉 ??prev 媛깆떊 (?ш컧吏 諛⑹?)
                                self._stop_event.wait(0.05)
                                continue
                            # 鍮꾩젙??醫뚰몴 ?먰봽: portal_grace/mark_portal_entry濡?泥섎━ ?????먰봽
                            if (current_x, current_y) == _jump_reject_coord:
                                _jump_reject_count += 1
                                if _jump_reject_count >= 3:
                                    # ?숈씪 醫뚰몴 3??諛섎났 = ?ㅼ젣 醫뚰몴 蹂寃쎌씠吏留??덉긽???ы깉 ?꾨떂
                                    # ??留??ㅼ뿼 諛⑹?瑜??꾪빐 ?ㅽ뻾 以묒?
                                    self._special_diag(
                                        "ocr_jump_abort",
                                        iter=iteration,
                                        prev=f"{prev_x},{prev_y}",
                                        cur=f"{current_x},{current_y}",
                                        jump=jump,
                                        reject_count=_jump_reject_count,
                                    )
                                    self.after(0, lambda cx=current_x, cy=current_y, px=prev_x, py=prev_y, j=jump:
                                        self._append_log(f"?썞 鍮꾩젙??醫뚰몴 ?먰봽: ({px},{py})??{cx},{cy}) 嫄곕━={j} ???ㅽ뻾 以묒?"))
                                    self._stop_event.set()
                                    break
                            else:
                                _jump_reject_coord = (current_x, current_y)
                                _jump_reject_count = 1
                            self._special_diag(
                                "ocr_jump_ignored",
                                iter=iteration,
                                prev=f"{prev_x},{prev_y}",
                                cur=f"{current_x},{current_y}",
                                jump=jump,
                                reject_count=_jump_reject_count,
                            )
                            self.after(0, lambda cx=current_x, cy=current_y, px=prev_x, py=prev_y, j=jump:
                                self._append_log(f"?좑툘 醫뚰몴 ?먰봽 臾댁떆: ({px},{py})??{cx},{cy}) 嫄곕━={j}"))
                            self._stop_event.wait(0.1)
                            continue
                    elif (full_mapping_exploring or _local_explore_phase) and jump >= 5:
                        # 留듯븨 以?5移? ?먰봽 = ?ы깉 諛잛쓬 ???ы깉 ???踰??깅줉 ???먯깋 怨꾩냽
                        if last_dir and mapping_on and use_map:
                            _pdx, _pdy = DIRECTIONS_4.get(last_dir, (0, 0))
                            _portal_tile = (prev_x + _pdx, prev_y + _pdy)
                            self._game_map.mark_blocked(_portal_tile[0], _portal_tile[1])
                            _portal_protected.add(_portal_tile)
                            self._special_diag(
                                "mapping_portal_detected",
                                iter=iteration,
                                prev=f"{prev_x},{prev_y}",
                                cur=f"{current_x},{current_y}",
                                jump=jump,
                                portal_tile=f"{_portal_tile[0]},{_portal_tile[1]}",
                            )
                            self.after(0, lambda pt=_portal_tile, cx=current_x, cy=current_y, px=prev_x, py=prev_y:
                                self._append_log(f"?슞 留듯븨 以??ы깉 媛먯?: ({px},{py})??{cx},{cy}) ??{pt} 踰??깅줉"))
                        # 留듯븨 以??ы깉: 踰??깅줉 ???먯깋 怨꾩냽 (以묒? ????
                        self._game_map.mark_passable(current_x, current_y)
                        current_path = []
                        stuck_count = 0
                        last_dir = None
                        prev_x, prev_y = current_x, current_y  # ?ы깉 ??prev 媛깆떊 (?ш컧吏 諛⑹?)
                        self._stop_event.wait(0.05)
                        continue
                    else:
                        _jump_reject_coord = None
                        _jump_reject_count = 0

                # 援ш컙 ?꾪솚 ??泥?醫뚰몴 ??異쒕컻吏 + 踰??깅줉 (?섎룎?꾧?湲?諛⑹?)
                # 利됱떆 ?깅줉?섎릺, 醫뚰몴媛 ?섏쨷??諛붾뚮㈃ start_pos??媛깆떊??                if mark_portal_entry and mapping_on and use_map:
                    mark_portal_entry = False
                    # 留듯븨?뚯뒪??+ 異쒕컻醫뚰몴 ?놁쓬 = ?쒕뜡異쒕컻 ??異쒕컻吏 踰??깅줉 ????                    _mt_no_starts = _is_mapping_test and not (len(all_targets[target_idx]) > 8 and all_targets[target_idx][8])
                    _pending_start_pos = (current_x, current_y)
                    if _mt_no_starts:
                        self._game_map.start_pos = None
                        self._game_map.mark_passable(current_x, current_y)
                        self.after(0, lambda cx=current_x, cy=current_y:
                            self._append_log(f"?슞 異쒕컻吏 ?깅줉 (踰??놁쓬, ?쒕뜡異쒕컻): ({cx},{cy})"))
                    else:
                        self._game_map.start_pos = _pending_start_pos
                        self._game_map.mark_blocked(current_x, current_y)
                        self.after(0, lambda cx=current_x, cy=current_y:
                            self._append_log(f"?슞 異쒕컻吏 ?깅줉 + 踰? ({cx},{cy})"))
                    # 留듯븨?뚯뒪?? ?꾩껜留듯븨 ?ㅼ젙 (start_pos ?댁젣 + ?꾩갑吏/異쒕컻吏 踰?
                    if full_mapping_exploring:
                        # start_pos 癒쇱? ?댁젣 ??mark_passable??start_pos 蹂댄샇??嫄몃━吏 ?딆쓬
                        self._game_map.start_pos = None
                        self._game_map.mark_passable(current_x, current_y)
                        _pe_x, _pe_y = target_x, target_y
                        if _pe_x is not None and _pe_y is not None and (_pe_x, _pe_y) != (current_x, current_y):
                            if _is_mapping_test:
                                self._game_map.mark_passable(_pe_x, _pe_y)
                            else:
                                self._game_map.mark_blocked(_pe_x, _pe_y)
                            _portal_protected.add((_pe_x, _pe_y))
                        _pe_routes = all_targets[target_idx][7] if len(all_targets[target_idx]) > 7 else []
                        for _pex, _pey in _pe_routes:
                            if (_pex, _pey) != (current_x, current_y):
                                if _is_mapping_test:
                                    self._game_map.mark_passable(_pex, _pey)
                                else:
                                    self._game_map.mark_blocked(_pex, _pey)
                                _portal_protected.add((_pex, _pey))
                        # 異쒕컻醫뚰몴(異쒖엯援??ы깉): 吏꾩엯 ??쇱? passable ?좎? (?먯깋 ??蹂듦? 媛??
                        # ?ㅻⅨ 異쒕컻醫뚰몴留?blocked ?깅줉
                        _pe_starts = all_targets[target_idx][8] if len(all_targets[target_idx]) > 8 else []
                        for _psx, _psy in _pe_starts:
                            if (_psx, _psy) != (current_x, current_y):
                                self._game_map.mark_blocked(_psx, _psy)
                            _portal_protected.add((_psx, _psy))
                        self.after(0, lambda cx=current_x, cy=current_y:
                            self._append_log(f"?뱧 ?꾩껜留듯븨 ?쒖옉: ({cx},{cy})"))
                    # ?ъ슜??吏??踰쎌쥖???깅줉
                    _route_walls = all_targets[target_idx][10] if len(all_targets[target_idx]) > 10 else []
                    for _wx, _wy in _route_walls:
                        self._game_map.mark_blocked(_wx, _wy)
                        _portal_protected.add((_wx, _wy))
                    if _route_walls:
                        self.after(0, lambda n=len(_route_walls): self._append_log(f"?㎟ 踰쎌쥖??{n}媛??깅줉"))

                # 泥?諛섎났: ?쒖옉 ?꾩튂 ?깅줉 (1?뚮쭔 ?ㅽ뻾)
                if prev_x is None and mapping_on and use_map and not getattr(self, '_start_registered', False):
                    self._start_registered = True
                    # 留듯븨?뚯뒪??+ 異쒕컻醫뚰몴 ?놁쓬 = ?쒕뜡異쒕컻 ??異쒕컻吏 踰??깅줉 ????                    _mt_no_starts_init = _is_mapping_test and not (len(all_targets[target_idx]) > 8 and all_targets[target_idx][8])
                    # 異쒕컻吏 ???                    if _mt_no_starts_init:
                        self._game_map.start_pos = None
                        self._game_map.mark_passable(current_x, current_y)
                    elif full_mapping_exploring:
                        # ?꾩껜留듯븨: entry tile passable + start_pos=None
                        # ??A*/BFS媛 entry tile 寃쎌쑀 媛?????몄젒 踰????쇱そ) ?먯? 媛??                        self._game_map.start_pos = None
                        self._game_map.mark_passable(current_x, current_y)
                    else:
                        self._game_map.start_pos = (current_x, current_y)
                    # ?꾩껜留듯븨: entry tile passable ?좎?, portal_protected濡?蹂댄샇
                    # ??A*/BFS媛 entry tile 寃쎌쑀 媛?????몄젒 踰??먯? 媛??                    if full_mapping_exploring and not _mt_no_starts_init:
                        # entry tile? passable ?좎? ??portal_protected濡쒕쭔 蹂댄샇
                        _portal_protected.add((current_x, current_y))
                        # ?꾩갑吏(?ы깉 異쒓뎄) ??留듯븨?뚯뒪?몃뒗 passable ?좎? (?몄젒 踰??먯? ?꾩슂)
                        _end_x, _end_y = target_x, target_y
                        if _end_x is not None and _end_y is not None and (_end_x, _end_y) != (current_x, current_y):
                            if _is_mapping_test:
                                # 留듯븨?뚯뒪?? passable ?좎? + portal_protected (踰??먯? ?덉슜)
                                self._game_map.mark_passable(_end_x, _end_y)
                            else:
                                self._game_map.mark_blocked(_end_x, _end_y)
                            _portal_protected.add((_end_x, _end_y))
                            self.after(0, lambda ex=_end_x, ey=_end_y, mt=_is_mapping_test:
                                self._append_log(f"{'?뱧' if mt else '?슟'} ?꾩갑吏 {'蹂댄샇' if mt else '踰?}: ({ex},{ey})"))
                        # ?꾩갑醫뚰몴媛 ?щ윭 媛쒕㈃ 泥섎━
                        _end_routes = all_targets[target_idx][7] if len(all_targets[target_idx]) > 7 else []
                        for _ex, _ey in _end_routes:
                            if (_ex, _ey) != (current_x, current_y):
                                if _is_mapping_test:
                                    self._game_map.mark_passable(_ex, _ey)
                                else:
                                    self._game_map.mark_blocked(_ex, _ey)
                                _portal_protected.add((_ex, _ey))
                        # 異쒕컻醫뚰몴(異쒖엯援??ы깉): entry tile? passable ?좎?, ?섎㉧吏留?踰??깅줉
                        _start_routes = all_targets[target_idx][8] if len(all_targets[target_idx]) > 8 else []
                        for _sx, _sy in _start_routes:
                            if (_sx, _sy) != (current_x, current_y):
                                self._game_map.mark_blocked(_sx, _sy)
                            _portal_protected.add((_sx, _sy))
                        # 4諛⑺뼢 紐⑤몢 踰쎌씠硫?媛뉙옒) ?몄젒 踰??댁젣, ?꾨땲硫?湲곗〈 踰??좎?
                        blocked_neighbors = sum(
                            1 for d, (ddx, ddy) in DIRECTIONS_4.items()
                            if self._game_map.is_blocked(current_x + ddx, current_y + ddy))
                        unblocked = 0
                        if blocked_neighbors >= 4 and not _is_mapping_mode:
                            for d, (ddx, ddy) in DIRECTIONS_4.items():
                                nx, ny = current_x + ddx, current_y + ddy
                                if (nx, ny) in _portal_protected:
                                    continue  # ?ы깉 醫뚰몴 蹂댄샇
                                if self._game_map.is_blocked(nx, ny):
                                    self._game_map.mark_passable(nx, ny)
                                    unblocked += 1
                        elif blocked_neighbors >= 4 and _is_mapping_mode:
                            self._special_diag(
                                "wall_unblock_skip_mapping",
                                iter=iteration,
                                trigger="full_mapping_start_trapped",
                                pos=f"{current_x},{current_y}",
                            )
                        self.after(0, lambda cx=current_x, cy=current_y, ub=unblocked:
                            self._append_log(f"?뱧 ?꾩껜留듯븨 ?쒖옉: ({cx},{cy})" + (f" [媛뉙옒?믪씤?묐꼍 {ub}媛??댁젣]" if ub else "")))
                    # 蹂댁뒪 ?섏쟾?대㈃ 異쒕컻吏=?ы깉?대?濡?踰??깅줉 (?섎룎?꾧?湲?諛⑹?)
                    elif all_targets[target_idx][3]:
                        self._game_map.mark_blocked(current_x, current_y)
                        self.after(0, lambda cx=current_x, cy=current_y:
                            self._append_log(f"?슞 異쒕컻吏(?ы깉) 踰??깅줉: ({cx},{cy})"))
                    else:
                        self._game_map.mark_passable(current_x, current_y)
                        self.after(0, lambda cx=current_x, cy=current_y:
                            self._append_log(f"?뱧 ?쒖옉 ?꾩튂: ({cx},{cy})"))
                    # 洹쇱쿂 ?꾩껜留듯븨 ?쒖옉 ?꾩튂 湲곕줉
                    if _local_explore_phase and _local_explore_center is None:
                        _local_explore_center = (current_x, current_y)
                    # ?ъ슜??吏??踰쎌쥖???깅줉 (泥?援ш컙)
                    _route_walls_init = all_targets[target_idx][10] if len(all_targets[target_idx]) > 10 else []
                    for _wx, _wy in _route_walls_init:
                        self._game_map.mark_blocked(_wx, _wy)
                        _portal_protected.add((_wx, _wy))
                    if _route_walls_init:
                        self.after(0, lambda n=len(_route_walls_init): self._append_log(f"?㎟ 踰쎌쥖??{n}媛??깅줉"))

                # ?꾩껜留듯븨 ?덉쟾?μ튂: 異쒕컻/?꾩갑(?ы깉) 醫뚰몴 ?ъ쭊??湲덉?
                if full_mapping_exploring and mapping_on and use_map:
                    _fm_forbidden = set(all_targets[target_idx][7] if len(all_targets[target_idx]) > 7 else [])
                    _fm_forbidden.update(all_targets[target_idx][8] if len(all_targets[target_idx]) > 8 else [])
                    if target_x is not None and target_y is not None:
                        _fm_forbidden.add((int(target_x), int(target_y)))
                    if _pending_start_pos is not None:
                        _fm_forbidden.add((_pending_start_pos[0], _pending_start_pos[1]))
                    if self._game_map.start_pos is not None:
                        _fm_forbidden.add((self._game_map.start_pos[0], self._game_map.start_pos[1]))
                    _fm_blocked = 0
                    for _fx, _fy in _fm_forbidden:
                        _portal_protected.add((_fx, _fy))
                        if (_fx, _fy) == (current_x, current_y):
                            continue
                        if not self._game_map.is_blocked(_fx, _fy):
                            self._game_map.mark_blocked(_fx, _fy)
                            _fm_blocked += 1
                    if _fm_blocked > 0 and _ui_update_ok:
                        self.after(0, lambda c=_fm_blocked: self._append_log(f"?슟 ?꾩껜留듯븨 ?ы깉醫뚰몴 李⑤떒 {c}媛?))

                # 蹂댁뒪 ?섏쟾 寃쎌쑀吏??醫뚰몴 湲곕컲 ?꾩갑 泥댄겕 嫄대꼫? (醫뚰몴媛 0,0)
                # ?꾩껜留듯븨 ?꾨윴?곗뼱 ?먯깋 以묒씠硫?蹂댁뒪?섏쟾 ?몃뱾???ъ슜
                # 留듯븨?뚯뒪?? 留??곗씠??50??? ?대㈃ 理쒕떒寃쎈줈 A* 紐⑤뱶 (罹먮┃???꾩튂 臾닿?)
                _mt_has_map = _is_mapping_test and len(self._game_map.passable) >= 50
                # 留듯븨?뚯뒪?? ?먯깋 ?꾨즺 ??full_mapping/local_explore ????False)?먮뒗
                # 蹂댁뒪 援ш컙?댁뼱??is_boss_dungeon=False ???꾩갑 泥댄겕 ?쒖꽦??                _mt_explore_done = _is_mapping_test and not full_mapping_exploring and not _local_explore_phase
                is_boss_dungeon = (all_targets[target_idx][3] and not _mt_explore_done) or _local_explore_phase or full_mapping_exploring
                # 蹂댁뒪 寃쎌쑀吏硫?auto-save 李⑤떒 (留듯븨?뚯뒪?몄뿉?쒕뒗 ??긽 ?덉슜 ??留??곗씠???좎떎 諛⑹?)
                self._boss_segment_active = all_targets[target_idx][3] and not _is_mapping_test

                # ?꾩갑 泥댄겕 (?뺥솗??醫뚰몴 ?쇱튂 ???ы깉? ?뺥솗 醫뚰몴?먯꽌留??묐룞)
                # ?꾩갑醫뚰몴媛 ?щ윭 媛쒕㈃ ?대뒓 ?섎굹?쇰룄 諛잛쑝硫??꾩갑 泥섎━
                _cur_route_ends = all_targets[target_idx][7] if len(all_targets[target_idx]) > 7 else []
                if _cur_route_ends:
                    _arrived = any(current_x == ex and current_y == ey for ex, ey in _cur_route_ends)
                else:
                    _arrived = (abs(current_x - target_x) + abs(current_y - target_y) == 0)
                if _arrived and not is_boss_dungeon and portal_grace <= 0:
                    # 留듯븨 紐⑤뱶: 紐⑺몴 ?꾨떖 ??泥섎━
                    if getattr(self, '_is_mapping', False):
                        mapping_mode = getattr(self, '_mapping_mode', 'path')
                        if mapping_mode == "path":
                            # 寃쎈줈留듯븨: 紐⑺몴 ?꾨떖 ??利됱떆 ?꾨즺
                            if use_map:
                                self._game_map.end_pos = (current_x, current_y)
                            self.after(0, lambda cx=current_x, cy=current_y:
                                self._append_log(f"?렞 寃쎈줈留듯븨 ?꾨즺! ({cx},{cy})"))
                            return
                        elif not _mt_explore_done and not _segment_map_locked:
                            # ?꾩껜留듯븨: 紐⑺몴 ?꾨떖?대룄 怨꾩냽 ?먯깋 (?꾨윴?곗뼱 ?놁쓣 ?뚭퉴吏)
                            # ???대? ?꾩껜留듯븨 ?꾨즺(_mt_explore_done) ?먮뒗 ?좉툑 留듭씠硫?嫄대꼫?
                            self.after(0, lambda cx=current_x, cy=current_y:
                                self._append_log(f"?뱧 紐⑺몴 ?꾨떖 ({cx},{cy}) - ?꾩껜留듯븨 怨꾩냽..."))
                            # 紐⑺몴瑜??꾨떖?덉쑝誘濡??먯깋 紐⑤뱶濡??꾪솚 (is_boss_dungeon泥섎읆 ?숈옉)
                            is_boss_dungeon = True  # ?꾩껜留듯븨? 蹂댁뒪 ?섏쟾泥섎읆 ?꾨윴?곗뼱 ?먯깋
                            full_mapping_exploring = True  # ?ㅼ쓬 諛섎났?먯꽌??蹂댁뒪?섏쟾 ?몃뱾??吏꾩엯
                            _mt_map_recording_frozen = False
                            _is_mapping_mode = _is_mapping_test or full_mapping_exploring
                            # start_pos ?댁젣 (A*媛 異쒕컻吏瑜?踰쎌쑝濡?痍④툒?섎뒗 臾몄젣 諛⑹?)
                            if use_map:
                                self._game_map.start_pos = None
                                # ?꾩갑吏 踰??깅줉 ???먯깋 以??ы깉 吏꾩엯 諛⑹?
                                _et_x, _et_y = target_x, target_y
                                if _et_x is not None and _et_y is not None and (_et_x, _et_y) != (current_x, current_y):
                                    if _is_mapping_test:
                                        self._game_map.mark_passable(_et_x, _et_y)
                                    else:
