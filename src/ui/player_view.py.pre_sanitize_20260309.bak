            state="disabled",
        )
        self._play_btn.pack(side="left", padx=(0, 6))

        self._pause_btn = ctk.CTkButton(
            play_btn_frame,
            text="???쇱떆?뺤?",
            command=self._on_pause,
            width=90,
            height=36,
            fg_color=COLORS["warning"],
            hover_color="#b8860b",
            text_color="white",
            font=ctk.CTkFont(size=13, weight="bold"),
            corner_radius=6,
            state="disabled",
        )
        self._pause_btn.pack(side="left", padx=(0, 6))

        self._stop_btn = ctk.CTkButton(
            play_btn_frame,
            text="??以묒?",
            command=self._on_stop,
            width=90,
            height=36,
            fg_color=COLORS["error"],
            hover_color="#c62828",
            text_color="white",
            font=ctk.CTkFont(size=13, weight="bold"),
            corner_radius=6,
            state="disabled",
        )
        self._stop_btn.pack(side="left")

        # ?덈줈怨좎묠 踰꾪듉 ?꾨젅??        btn_frame = ctk.CTkFrame(self._selection_card, fg_color="transparent")
        btn_frame.pack(fill="x", padx=15, pady=(0, 10))

        self.create_button(
            btn_frame,
            text="?덈줈怨좎묠",
            command=self._load_sequences,
            style="secondary",
            width=100,
        ).pack(side="right")

    def _setup_control_panel(self, parent) -> None:
        """而⑦듃濡??⑤꼸 援ъ꽦"""
        self._control_card = self.create_card(parent, title="?ㅽ뻾 ?ㅼ젙")
        self._control_card.pack(fill="both", expand=True)

        # ?좏깮 ?뺣낫 ?꾨젅??        info_frame = ctk.CTkFrame(
            self._control_card,
            fg_color=COLORS["bg_dark"],
            corner_radius=8,
        )
        info_frame.pack(fill="x", padx=15, pady=(0, 15))

        self._selected_label = self.create_label(
            info_frame,
            text="?좏깮???ъ깮: ?놁쓬",
            style="body",
        )
        self._selected_label.pack(side="left", padx=15, pady=12)

        self._action_count_label = self.create_label(
            info_frame,
            text="",
            style="caption",
        )
        self._action_count_label.pack(side="left", padx=5, pady=12)

        # ?ㅼ젙 ?꾨젅??        settings_frame = ctk.CTkFrame(self._control_card, fg_color="transparent")
        settings_frame.pack(fill="x", padx=15, pady=(0, 15))

        # ?ㅽ뻾 ?띾룄
        speed_frame = ctk.CTkFrame(settings_frame, fg_color="transparent")
        speed_frame.pack(fill="x", pady=5)

        speed_label_frame = ctk.CTkFrame(speed_frame, fg_color="transparent")
        speed_label_frame.pack(side="left")

