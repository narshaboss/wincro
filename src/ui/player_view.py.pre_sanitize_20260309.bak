                                    elif _is_backtrack_dir:
                                        # 諛깊듃?섑궧?댁뼱??紐⑺몴 嫄곕━ 媛먯냼硫??ㅽ뙣濡?蹂댁? ?딆쓬
                                        if _dist_next >= _dist_now:
                                            explore_target_tries += 1
                                        elif explore_target_tries > 0:
                                            explore_target_tries -= 1
                                    else:
                                        explore_target_tries = 0   # ?뺤긽 寃쎈줈 = 由ъ뀑
                                if explore_target_tries >= _unreach_limit:
