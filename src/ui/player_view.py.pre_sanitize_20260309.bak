                        messagebox.showerror("?ㅻ쪟", "?쒕젅?댁? 踰붿쐞??0 ?댁긽?댁뼱???⑸땲??)
                        return
                    action.typing_random = typing_random_var.get()
                    action.typing_delay = typing_delay
                    action.typing_delay_range = typing_range

                result["saved"] = True
