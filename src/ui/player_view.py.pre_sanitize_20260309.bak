                                        if self._game_map.is_soft_blocked(_cnx, _cny):
                                            self._game_map.clear_soft_blocked(_cnx, _cny)
                                            _cleared += 1
                                    if _cleared > 0:
                                        self.after(0, lambda cx=current_x, cy=current_y, c=_cleared:
