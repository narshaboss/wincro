                            total_stuck_count += 1
                        unknown_path_fails += 1  # A* unknown 寃쎈줈 遺덉떊 ?꾩쟻
                        _is_mapping_mode_now = (_is_mapping_test or full_mapping_exploring)
                        if last_dir and prev_x is not None and portal_grace <= 0:
                            _fdx, _fdy = DIRECTIONS_4.get(last_dir, (0, 0))
                            _fail_tile = (prev_x + _fdx, prev_y + _fdy)
                            _fail_tile_passable = self._game_map.is_passable(_fail_tile[0], _fail_tile[1])
                            if _is_mapping_mode_now and use_map:
                                _edge_ttl = min(EDGE_BLOCK_TTL_MAX, 120 + stuck_count * 60)
                                _register_edge_block(
                                    prev_x, prev_y, last_dir, iteration,
                                    ttl=_edge_ttl,
                                    reason="move_fail_immediate",
                                )
                                self._special_diag(
                                    "move_fail_edge_block",
                                    iter=iteration,
                                    src=f"{prev_x},{prev_y}",
                                    dir=last_dir,
                                    tile=f"{_fail_tile[0]},{_fail_tile[1]}",
                                    tile_passable=_fail_tile_passable,
                                    edge_ttl=_edge_ttl,
                                )
                                if _fail_tile_passable:
                                    _reverse_dir = _opposite_dir(last_dir)
                                    if _reverse_dir:
                                        _fail_tried = explored_from.get(_fail_tile, set())
                                        if _reverse_dir not in _fail_tried:
                                            _fail_tried = set(_fail_tried)
                                            _fail_tried.add(_reverse_dir)
                                            explored_from[_fail_tile] = _fail_tried
                                            self._special_diag(
                                                "move_fail_mark_reverse_tried",
                                                iter=iteration,
                                                tile=f"{_fail_tile[0]},{_fail_tile[1]}",
                                                dir=_reverse_dir,
                                                from_pos=f"{prev_x},{prev_y}",
                                            )
                            _avoid_ttl = min(25, 8 + stuck_count * 3)
                            _skip_tile_avoid = (_is_mapping_mode_now and _fail_tile_passable)
                            if not _skip_tile_avoid:
                                move_fail_avoid[_fail_tile] = max(
                                    move_fail_avoid.get(_fail_tile, 0),
                                    iteration + _avoid_ttl,
                                )
                            if stuck_count >= 2:
                                self._special_diag(
                                    "move_fail_tile_avoid",
                                    iter=iteration,
                                    tile=f"{_fail_tile[0]},{_fail_tile[1]}",
                                    until=move_fail_avoid.get(_fail_tile, 0),
                                    ttl=_avoid_ttl,
                                    stuck=stuck_count,
                                    skipped=int(_skip_tile_avoid),
                                )
                                if _skip_tile_avoid and _ui_update_ok:
                                    self.after(0, lambda px=prev_x, py=prev_y, d2=last_dir:
                                        self._append_log(f"?㎛ 諛⑺뼢李⑤떒 ?좎?: ({px},{py}) {d2} (??쇳쉶???앸왂)"))
                        if not self._stop_event.is_set() and _ui_update_ok:
                            self.after(0, lambda px=prev_x, py=prev_y, d=last_dir, sc=stuck_count:
                                self._append_log(f"??({px},{py}) {d} ?ㅽ뙣 (?뺤껜:{sc})"))
                        # ?ㅽ뙣??諛⑺뼢 湲곕줉: 踰??뺤젙 ?꾩뿉??湲곕줉?섏? ?딆쓬 (?ъ떆?꾨줈 stuck_count 3 ?꾨떖 蹂댁옣)
                        # 踰??뺤젙(stuck_count>=3) ???꾨옒?먯꽌 湲곕줉
                        _is_mapping_mode = _is_mapping_mode_now
                        if not _is_mapping_mode and last_dir and prev_x is not None:
                            fail_pos = (prev_x, prev_y)
                            tried = explored_from.get(fail_pos, set())
                            tried.add(last_dir)
                            explored_from[fail_pos] = tried
                        _wall_threshold = 3 if _is_mapping_mode else 2
                        self._special_diag(
                            "move_fail",
                            iter=iteration,
                            pos=f"{prev_x},{prev_y}",
                            last_dir=last_dir,
                            stuck=stuck_count,
                            total_stuck=total_stuck_count,
                            unknown_fails=unknown_path_fails,
                            wall_threshold=_wall_threshold,
                            mapping_mode=_is_mapping_mode,
                            portal_grace=portal_grace,
                        )
                        if stuck_count >= _wall_threshold and last_dir and portal_grace <= 0:
                            if use_map:
                                ddx, ddy = DIRECTIONS_4.get(last_dir, (0, 0))
                                wall_x = prev_x + ddx
                                wall_y = prev_y + ddy
                                _edge_only_block = False

                                if _segment_map_locked:
                                    # ?좉툑留? ?붿뒪?щ뒗 嫄대뱶由ъ? ?딄퀬 硫붾え由ъ뿉?쒕쭔 ?섎뱶踰?泥섎━
                                    if not self._game_map.is_blocked(wall_x, wall_y):
                                        self._game_map.mark_blocked(wall_x, wall_y)
                                elif mapping_on:
                                    # 留?湲곕줉 紐⑤뱶: 踰??깅줉
                                    if boss_mode == "patrolling":
                                        if not self._game_map.is_blocked(wall_x, wall_y):
                                            if _is_mapping_mode:
                                                self._game_map.mark_blocked(wall_x, wall_y)
                                                if _ui_update_ok:
                                                    self.after(0, lambda wx=wall_x, wy=wall_y:
                                                        self._append_log(f"?㎟ 踰? x{wx}y{wy}"))
                                            else:
                                                self._game_map.mark_blocked(wall_x, wall_y)
                                                if _ui_update_ok:
                                                    self.after(0, lambda wx=wall_x, wy=wall_y:
                                                        self._append_log(f"?㎟ 踰? x{wx}y{wy} (紐ъ뒪?곗텛??"))
                                    else:
                                        _wall_pos = (wall_x, wall_y)
                                        _recent_passable = set(recent_positions[-12:]) | set(recent_valid_coords[-15:])
                                        _likely_passable = (
                                            self._game_map.is_passable(wall_x, wall_y)
                                            or (wall_x, wall_y) in _recent_passable
                                            or visit_counts.get(_wall_pos, 0) > 0
                                            or (wall_x, wall_y) == (current_x, current_y)
                                            or (wall_x, wall_y) == (prev_x, prev_y)
                                        )
                                        if last_dir in ("up", "down"):
                                            _orth_neighbors = [(wall_x - 1, wall_y), (wall_x + 1, wall_y)]
                                        else:
                                            _orth_neighbors = [(wall_x, wall_y - 1), (wall_x, wall_y + 1)]
                                        _orth_passable = sum(
                                            1 for nx, ny in _orth_neighbors
                                            if self._game_map.is_passable(nx, ny)
                                        )
                                        _failed_dir_count = _record_wall_fail_dir(_wall_pos, last_dir)
                                        _prefer_edge_only = (
                                            _is_mapping_mode
                                            and (_likely_passable or (_orth_passable >= 2 and _failed_dir_count <= 1))
                                        )

                                        if _prefer_edge_only:
                                            _edge_only_block = True
                                            _edge_ttl = min(EDGE_BLOCK_TTL_MAX, 260 + stuck_count * 120)
                                            _register_edge_block(
                                                prev_x, prev_y, last_dir, iteration,
                                                ttl=_edge_ttl,
                                                reason="likely_passable_or_orth_open",
                                            )
                                            wall_confirm_hits.pop(_wall_pos, None)
                                            if self._game_map.is_blocked(wall_x, wall_y) and _wall_pos not in _portal_protected:
                                                self._game_map.mark_passable(wall_x, wall_y)
                                                self._special_diag(
                                                    "edge_block_unblock_tile",
                                                    iter=iteration,
                                                    wall=f"{wall_x},{wall_y}",
                                                    reason="blocked_but_edge_only",
                                                )
                                            self._special_diag(
                                                "wall_as_edge_block",
                                                iter=iteration,
                                                wall=f"{wall_x},{wall_y}",
                                                src=f"{prev_x},{prev_y}",
                                                dir=last_dir,
                                                orth_passable=_orth_passable,
                                                fail_dirs=_failed_dir_count,
                                                likely_passable=_likely_passable,
                                            )
                                            if _ui_update_ok:
                                                self.after(0, lambda px=prev_x, py=prev_y, d2=last_dir, wx=wall_x, wy=wall_y:
                                                    self._append_log(f"?㎛ 諛⑺뼢李⑤떒: ({px},{py}) {d2} (??쇱쑀吏 x{wx}y{wy})"))
                                        elif not self._game_map.is_blocked(wall_x, wall_y):
                                            if _is_mapping_mode:
                                                # 留듯븨 紐⑤뱶: ?꾩떆踰?????곴뎄踰??곗꽑 (?? 諛⑺뼢李⑤떒 耳?댁뒪 ?쒖쇅)
                                                self._game_map.mark_blocked(wall_x, wall_y)
                                                wall_confirm_hits.pop(_wall_pos, None)
                                                _clear_wall_fail_dir(_wall_pos)
                                                self._special_diag(
                                                    "wall_hard_block_mapping_strict",
                                                    iter=iteration,
                                                    wall=f"{wall_x},{wall_y}",
                                                    current=f"{current_x},{current_y}",
                                                    prev=f"{prev_x},{prev_y}",
                                                    last_dir=last_dir,
                                                    stuck=stuck_count,
                                                    orth_passable=_orth_passable,
                                                    fail_dirs=_failed_dir_count,
                                                )
                                                if _ui_update_ok:
                                                    self.after(0, lambda wx=wall_x, wy=wall_y:
                                                        self._append_log(f"?㎟ 踰? x{wx}y{wy}"))
                                            elif _likely_passable:
                                                self._game_map.mark_blocked(wall_x, wall_y)
                                                wall_confirm_hits.pop(_wall_pos, None)
                                                self._special_diag(
                                                    "wall_hard_block_recent_override",
                                                    iter=iteration,
                                                    wall=f"{wall_x},{wall_y}",
                                                    current=f"{current_x},{current_y}",
                                                    prev=f"{prev_x},{prev_y}",
                                                    last_dir=last_dir,
                                                    stuck=stuck_count,
                                                )
                                                if _ui_update_ok:
                                                    self.after(0, lambda wx=wall_x, wy=wall_y:
                                                        self._append_log(f"?㎟ 踰? x{wx}y{wy} (理쒓렐?대룞 媛뺤젣?깅줉)"))
                                            elif self._game_map.is_soft_blocked(wall_x, wall_y):
                                                # ?꾩떆踰??ъ슜 以묐떒: 湲곗〈 ?꾩떆踰쎈룄 利됱떆 ?섎뱶踰쎌쑝濡??밴꺽
                                                self._game_map.clear_soft_blocked(wall_x, wall_y)
                                                self._game_map.mark_blocked(wall_x, wall_y)
                                                if _ui_update_ok:
                                                    self.after(0, lambda wx=wall_x, wy=wall_y:
                                                        self._append_log(f"?㎟ 踰??뺤젙: x{wx}y{wy} (?꾩떆踰쎌듅寃?"))
                                            elif self._game_map.is_passable(wall_x, wall_y):
                                                self._game_map.mark_blocked(wall_x, wall_y)
                                                if _ui_update_ok:
                                                    self.after(0, lambda wx=wall_x, wy=wall_y:
                                                        self._append_log(f"?㎟ 踰? x{wx}y{wy} (湲곗〈寃쎈줈 媛뺤젣?깅줉)"))
                                            else:
                                                self._game_map.mark_blocked(wall_x, wall_y)
                                                _clear_wall_fail_dir(_wall_pos)
                                                self._special_diag(
                                                    "wall_hard_block_general",
                                                    iter=iteration,
                                                    wall=f"{wall_x},{wall_y}",
                                                    current=f"{current_x},{current_y}",
                                                    prev=f"{prev_x},{prev_y}",
                                                    last_dir=last_dir,
                                                    stuck=stuck_count,
                                                )
                                                if _ui_update_ok:
                                                    self.after(0, lambda wx=wall_x, wy=wall_y:
                                                        self._append_log(f"?㎟ 踰??뺤젙: x{wx}y{wy}"))
                                    # 踰?諛쒓껄?????(?붾컮?댁뒪, 以묒? ???앸왂)
                                    if not _no_save and not self._map_save_lock.locked() and not self._stop_event.is_set():
                                        threading.Thread(target=self._auto_save_map, daemon=True).start()
                                else:
                                    # 遺遺꾩떎???꾩껜?뚯뒪?? ?꾩떆踰??ъ슜 ????(硫붾え由??섎뱶踰?
                                    if not self._game_map.is_blocked(wall_x, wall_y):
                                        self._game_map.mark_blocked(wall_x, wall_y)

                                # 踰쎌씠 ?꾩옱 ?꾨윴?곗뼱 紐⑺몴?대㈃ 利됱떆 臾댄슚??                                if not _edge_only_block and explore_target == (wall_x, wall_y):
                                    frontier_cooldown.add(explore_target)
                                    _remember_recent_frontier(explore_target, "blocked", iteration)
                                    explore_target = None
                                    explore_target_tries = 0

                                # 寃쎈줈 ?ш퀎???꾩슂
                                current_path = []
                                path_index = 0
                                path_pos_index = {}
                                pathfinder.invalidate_path()
                                # 誘몄? ?곸뿭 寃쎈줈 ?좊ː??媛먯냼 (踰?諛쒓껄 = 誘몄? ?곸뿭 寃쎈줈 ?ㅽ뙣)
                                # 3???꾩쟻 ??2李?誘몄? ?곸뿭) ?먯깋 鍮꾪솢????濡쒖뺄 ?먯깋?쇰줈 ?꾪솚
                                unknown_path_fails = min(unknown_path_fails + 1, 3)
                                if _ui_update_ok:
                                    if _edge_only_block:
                                        self.after(0, lambda: self._append_log("?봽 諛⑺뼢李⑤떒 ?깅줉 ??寃쎈줈 ?ш퀎??))
                                    else:
                                        self.after(0, lambda: self._append_log("?봽 踰?諛쒓껄 ??寃쎈줈 ?ш퀎??))
                                # 留듯븨?뚯뒪?? 踰??뺤젙 ??explored_from 湲곕줉 (?ъ떆??蹂댁옣 ??
                                if _is_mapping_mode and last_dir and prev_x is not None:
                                    fail_pos = (prev_x, prev_y)
                                    tried = explored_from.get(fail_pos, set())
                                    tried.add(last_dir)
                                    explored_from[fail_pos] = tried
                            stuck_count = 0
                            # ??total_stuck_count??由ъ뀑?섏? ?딆쓬 ??踰??깅줉 ?꾩뿉??                            # 怨꾩냽 ?뺤껜?섎㈃ ?κ린?뺤껜 蹂듦뎄(>=8)媛 諛쒕룞?댁빞 ??                            prev_x, prev_y = current_x, current_y  # ?꾩옱 ?꾩튂濡?媛깆떊 (異쒕컻吏 ?щ벑濡?諛⑹?)
                            last_dir = None
                            # continue ?쒓굅: OCR ?ъ씫湲?嫄대꼫?곌퀬 諛붾줈 寃쎈줈 ?ш퀎????利됱떆 ?대룞

                        # ?덉텧 ?ㅽ궗 泥댄겕 (?κ린?뺤껜 蹂듦뎄蹂대떎 癒쇱? ??total_stuck 由ъ뀑 ??
                        # 醫뚰몴媛 ???吏곸씠硫?諛쒕룞 (total_stuck_count = ?곗냽 ?대룞?ㅽ뙣 ?잛닔)
                        if (escape_skill_enabled and
                            total_stuck_count >= escape_skill_stuck_threshold and
                            time.time() - last_escape_time >= escape_skill_cooldown):

                            self.after(0, lambda tc=total_stuck_count:
                                self._append_log(f"?? ?덉텧 ?ㅽ궗 諛쒕룞! (?곗냽 ?뺤껜 {tc}??"))

                            try:
                                pyautogui.keyDown(escape_skill_key)
                                try:
                                    time.sleep(0.05)
                                finally:
                                    pyautogui.keyUp(escape_skill_key)
                            except Exception as e:
                                logger.error(f"[醫뚰몴紐⑤뱶] ?덉텧 ?ㅽ궗 ???낅젰 ?ㅽ뙣: {e}")
                                last_escape_time = time.time()  # ?ㅽ뙣?대룄 荑⑤떎???곸슜 (tight loop 諛⑹?)
                                prev_x, prev_y = None, None  # ?ㅽ궗 ?ㅽ뙣?대룄 ?꾩튂 由ъ뀑 (stale position 諛⑹?)
                                time.sleep(0.05)
                                continue
                            self._stop_event.wait(0.3)

                            dx = target_x - current_x
                            dy = target_y - current_y
                            if dx == 0 and dy == 0:
                                dir_name = last_dir or "right"
                            elif abs(dx) >= abs(dy):
                                dir_name = "right" if dx > 0 else "left"
                            else:
                                dir_name = "down" if dy > 0 else "up"
                            direction_key = self._config.move_keys.get(dir_name, dir_name)

                            for _ in range(escape_skill_direction_count):
                                pyautogui.press(direction_key)
                                time.sleep(0.05)

                            self._stop_event.wait(escape_skill_wait_after)

                            last_escape_time = time.time()
                            prev_x, prev_y = None, None
                            stuck_count = 0
                            total_stuck_count = 0
                            current_path = []
                            path_index = 0
                            path_pos_index = {}
                            explored_from = {}
                            unknown_path_fails = 0
                            time.sleep(0.05)
                            continue

                        # ?κ린 ?뺤껜 蹂듦뎄: ?몄젒 踰??댁젣 (?섎せ??踰??깅줉 ?먮룞 ?섏젙)
                        # 紐ъ뒪?????꾩떆 ?μ븷臾쇱씠 ?곴뎄踰쎌쑝濡??섎せ ?깅줉??寃쎌슦 蹂듦뎄
                        # ??吏곸쟾???ㅽ뙣??諛⑺뼢??踰쎌? ?댁젣?섏? ?딆쓬 (吏꾩쭨 踰?蹂댄샇)
                        if total_stuck_count >= 8 and use_map and not _is_mapping_mode:
                            unblocked = 0
                            fail_wall = None
                            if last_dir:
                                fdx, fdy = DIRECTIONS_4.get(last_dir, (0, 0))
                                fail_wall = (current_x + fdx, current_y + fdy)
                            _tried_here = explored_from.get((current_x, current_y), set())
                            for d, (ddx, ddy) in DIRECTIONS_4.items():
                                nx, ny = current_x + ddx, current_y + ddy
                                if (nx, ny) == fail_wall:
                                    continue  # 吏곸쟾 ?ㅽ뙣 諛⑺뼢 踰쎌? ?좎?
                                if d in _tried_here:
                                    continue  # ?대? ?ㅽ뙣??諛⑺뼢 踰쎈룄 ?좎?
                                if (nx, ny) in _portal_protected:
                                    continue  # ?ы깉 醫뚰몴 蹂댄샇
                                if self._game_map.is_blocked(nx, ny):
                                    self._game_map.mark_passable(nx, ny)
                                    unblocked += 1
                            if unblocked > 0:
                                self.after(0, lambda u=unblocked, cx=current_x, cy=current_y:
                                    self._append_log(f"?뵑 ?κ린?뺤껜({cx},{cy}) ??{u}媛??몄젒踰??댁젣 (?ㅽ뙣諛⑺뼢 ?쒖쇅)"))
                            total_stuck_count = 0
                            current_path = []
                            path_index = 0
                            path_pos_index = {}
                            pathfinder.invalidate_path()
                            # explored_from ?좎? (?뺤씤??踰?諛⑺뼢 湲곗뼲 ???댁젣 ???ъ떎??猷⑦봽 諛⑹?)
                        elif total_stuck_count >= 8 and use_map and _is_mapping_mode:
                            self._special_diag(
                                "wall_unblock_skip_mapping",
                                iter=iteration,
                                trigger="long_stuck",
                                pos=f"{current_x},{current_y}",
                                total_stuck=total_stuck_count,
                            )
                            total_stuck_count = 0
                            current_path = []
                            path_index = 0
                            path_pos_index = {}
                            pathfinder.invalidate_path()

                # soft_blocked ?먮룞 媛먯냼 (10?뚮쭏?? ??留듯븨?뚯뒪???꾩껜留듯븨?먯꽌??鍮꾪솢??(踰??좎? ?꾩닔), ?좉툑留듭? ?쒖꽦
                if use_map and (not _is_mapping_mode or _segment_map_locked):
                    tick_counter += 1
                    if tick_counter >= 10:
                        self._game_map.tick()
                        tick_counter = 0

                # ?곸떆 ?ㅽ궗 泥댄겕
                _t_skill = time.time()
                if auto_skill_enabled and auto_skill_key and not self._stop_event.is_set():
                    _use_skill = False
                    if _auto_skill_cd_tmpl is not None:
                        # ?대?吏 湲곕컲: OCR ?ㅽ겕由곗꺑 ?ъ궗??(異붽? ?ㅽ겕由곗꺑 遺덊븘??
                        try:
                            import cv2 as _ascv
                            import numpy as _asnp
                            _as_pil = getattr(matcher, '_last_screenshot', None)
                            if _as_pil is not None:
                                if auto_skill_cd_region and len(auto_skill_cd_region) == 4:
                                    _rx1, _ry1, _rx2, _ry2 = auto_skill_cd_region
                                    _as_cropped = _as_pil.crop((_rx1, _ry1, _rx2, _ry2))
                                    _as_scr = _ascv.cvtColor(_asnp.array(_as_cropped), _ascv.COLOR_RGB2BGR)
                                else:
                                    _as_scr = _ascv.cvtColor(_asnp.array(_as_pil), _ascv.COLOR_RGB2BGR)
                                _as_res = _ascv.matchTemplate(_as_scr, _auto_skill_cd_tmpl, _ascv.TM_CCOEFF_NORMED)
                                _, _as_max_val, _, _ = _ascv.minMaxLoc(_as_res)
                                if _as_max_val < 0.8:
                                    _use_skill = True
                        except Exception:
                            _use_skill = True
                    else:
                        # ?대?吏 誘몄꽕?? 留?諛섎났 ?ъ슜
                        _use_skill = True
                    if _use_skill:
                        try:
                            _orig_pause = pyautogui.PAUSE
                            pyautogui.PAUSE = 0
                            try:
                                pyautogui.keyDown(auto_skill_key)
                                time.sleep(0.015)
                                pyautogui.keyUp(auto_skill_key)
                            finally:
                                pyautogui.PAUSE = _orig_pause
                            self._key_press_count += 1
                        except Exception:
                            pass
                _t_skill_ms = int((time.time() - _t_skill) * 1000)
                if _t_skill_ms > 10:
                    logger.info(f"[??대컢] ?곸떆?ㅽ궗: {_t_skill_ms}ms")
                    if _ui_update_ok:
                        self.after(0, lambda ms=_t_skill_ms: self._append_log(f"???곸떆?ㅽ궗: {ms}ms"))

                # ?? 蹂댁뒪 ?섏쟾 ?몃뱾????
                if is_boss_dungeon:
                    current_pos_tuple = (current_x, current_y)

                    # 紐⑤뱶 ?곹깭 二쇨린??濡쒓렇 (30?뚮쭏??
                    if iteration % 30 == 1:
                        pc = len(self._game_map.passable) if use_map else 0
                        bc = len(self._game_map.blocked) if use_map else 0
                        self.after(0, lambda m=boss_mode, p=pc, b=bc, cx=current_x, cy=current_y:
                            self._append_log(f"?뱤 蹂댁뒪?섏쟾 [{m}] ({cx},{cy}) 留??대룞{p}/踰?b}"))

                    # ?붾젅?ы듃 ?湲? 援ш컙 ?꾪솚 ???꾩쭅 ?댁쟾 留듭뿉 ?덉쓬 ??留?湲곕줉 以묒? ?곹깭
                    if boss_pre_teleport:
                        if prev_x is not None:
                            jump_dist = abs(current_x - prev_x) + abs(current_y - prev_y)
                            teleport_threshold = max(8, int(interval / 0.02) + 5) if smooth_move else 5
                            if jump_dist >= teleport_threshold:
                                # ?붾젅?ы듃 ?꾨즺! 留?湲곕줉 ?ш컻
                                boss_pre_teleport = False
                                mapping_on = not _no_save
                                _segment_map_locked = all_targets[target_idx][9] if len(all_targets[target_idx]) > 9 else False
                                if _segment_map_locked:
                                    mapping_on = False
                                else:
                                    self._game_map.mark_blocked(current_x, current_y)
                                # 異쒓뎄 ?ы깉(route_starts) 踰??깅줉 + 蹂댄샇 (A* 寃쎌쑀 諛⑹?)
                                _boss_starts = all_targets[target_idx][8] if len(all_targets[target_idx]) > 8 else []
                                for _sx, _sy in _boss_starts:
                                    self._game_map.mark_blocked(_sx, _sy)
                                    _portal_protected.add((_sx, _sy))
                                # ?꾩갑 ?ы깉(route_ends) 踰??깅줉 + 蹂댄샇
                                _boss_ends = all_targets[target_idx][7] if len(all_targets[target_idx]) > 7 else []
                                for _ex, _ey in _boss_ends:
                                    self._game_map.mark_blocked(_ex, _ey)
                                    _portal_protected.add((_ex, _ey))
                                self.after(0, lambda cx=current_x, cy=current_y, ns=len(_boss_starts), ne=len(_boss_ends):
                                    self._append_log(f"?슞 蹂댁뒪 ?섏쟾 ?낆옣! ?낃뎄 踰??깅줉: ({cx},{cy})" +
                                                     (f" [?ы깉蹂댄샇: 異쒓뎄{ns}+?낃뎄{ne}]" if ns or ne else "")))
                                prev_x, prev_y = current_x, current_y
                                time.sleep(0.05)
                                continue
                        # ?꾩쭅 ?붾젅?ы듃 ?덈맖 ???대룞 ?쒕룄留?(留?湲곕줉 ?놁쓬)
                        prev_x, prev_y = current_x, current_y
                        self._stop_event.wait(0.3)  # ?대룞 ?湲?(0.3珥?
                        continue

                    # ?ы깉 ?덉텧 媛먯?: ?먯깋 以?醫뚰몴 ?먰봽 ???ы깉 ???踰??깅줉 + 蹂듦?
                    # ?꾩껜留듯븨 紐⑤뱶: ?ы깉 ?덉텧 媛먯? 鍮꾪솢?깊솕 (OCR ?ㅻ룆?쇰줈 ?명븳 ?ㅽ뙋 諛⑹?)
                    if prev_x is not None and not full_mapping_exploring:
                        jump_dist = abs(current_x - prev_x) + abs(current_y - prev_y)
                        # smooth_move: interval珥??숈븞 ??諛섎났 ??理쒕? ?대룞 嫄곕━ = interval / 0.02
                        if smooth_move:
                            max_normal_move = max(8, int(interval / 0.02) + 5)
                        else:
                            max_normal_move = 5
                        if jump_dist >= max_normal_move:
                            # 吏곸쟾 ?꾩튂媛 ?ы깉?댁뿀????踰쎌쑝濡??깅줉
                            if mapping_on and use_map:
                                _pj = (prev_x, prev_y)
                                _hit = _portal_escape_hits.get(_pj, 0) + 1
                                _portal_escape_hits[_pj] = min(_hit, 3)
                                self._special_diag(
                                    "portal_escape_jump",
                                    iter=iteration,
                                    prev=f"{prev_x},{prev_y}",
                                    cur=f"{current_x},{current_y}",
                                    jump=jump_dist,
                                    threshold=max_normal_move,
                                    hit=_hit,
                                )
                                # 硫붾え由??곹븳 (理쒓렐 ??ぉ留??좎?)
                                if len(_portal_escape_hits) > 200:
                                    for _k in list(_portal_escape_hits.keys())[:100]:
                                        _portal_escape_hits.pop(_k, None)

                                if _is_mapping_mode:
                                    # 留듯븨紐⑤뱶??2???뺤씤 ???섎뱶踰??뺤젙 (1???ㅽ깘 ?먰봽 諛⑹?, ?꾩떆踰?誘몄궗??
                                    if _hit >= 2:
                                        self._game_map.mark_blocked(prev_x, prev_y)
                                        self._special_diag(
                                            "portal_escape_block_mapping_strict",
                                            iter=iteration,
                                            tile=f"{prev_x},{prev_y}",
                                            hit=_hit,
                                        )
                                        self.after(0, lambda px=prev_x, py=prev_y:
                                            self._append_log(f"?슞 ?ы깉 ?덉텧 踰??깅줉! ({px},{py})"))
                                    else:
                                        self._special_diag(
                                            "portal_escape_block_mapping_pending",
                                            iter=iteration,
                                            tile=f"{prev_x},{prev_y}",
                                            hit=_hit,
                                        )
                                        if _ui_update_ok:
                                            self.after(0, lambda px=prev_x, py=prev_y:
                                                self._append_log(f"?좑툘 ?ы깉 ?덉텧 ?꾨낫: ({px},{py}) (1/2)"))
                                elif _hit >= 2:
                                    self._game_map.mark_blocked(prev_x, prev_y)
                                    self._special_diag(
                                        "portal_escape_block_confirmed",
                                        iter=iteration,
                                        tile=f"{prev_x},{prev_y}",
                                        hit=_hit,
                                    )
                                    self.after(0, lambda px=prev_x, py=prev_y:
                                        self._append_log(f"?슞 ?ы깉 ?덉텧 ?뺤젙! ({px},{py}) 踰??깅줉"))
                                else:
                                    # ?꾩떆踰??ъ슜 ???? 1??媛먯????꾨낫濡쒕쭔 ?좎?
                                    self._special_diag(
                                        "portal_escape_block_pending_nosoft",
                                        iter=iteration,
                                        tile=f"{prev_x},{prev_y}",
                                        hit=_hit,
                                    )
                                    self.after(0, lambda px=prev_x, py=prev_y:
                                        self._append_log(f"?좑툘 ?ы깉 ?덉텧 ?꾨낫({px},{py}) 蹂대쪟(踰쎈??깅줉)"))
                                if not _no_save:
                                    threading.Thread(target=self._auto_save_map, daemon=True).start()
                            # 留듯븨 紐⑤뱶: ?ы깉 ?섍컧 ??以묐떒
                            if getattr(self, '_is_mapping', False):
                                self._special_diag(
                                    "portal_escape_mapping_stop",
                                    iter=iteration,
                                    prev=f"{prev_x},{prev_y}",
                                    cur=f"{current_x},{current_y}",
                                    jump=jump_dist,
                                )
                                self.after(0, lambda: self._append_log("?좑툘 ?ы깉濡??섍컧 ??留듯븨 以묐떒 (?ъ떆?묓븯硫??ы깉 ?뚰뵾)"))
                                return
                            # ?뚯뒪??紐⑤뱶: ?ㅼ쓬 寃쎌쑀吏濡??꾪솚
                            prev_x, prev_y = current_x, current_y
                            time.sleep(0.05)
                            continue

                    # 蹂댁뒪 ?섏쟾: ?꾩옱 ?꾩튂瑜??대룞媛?μ쑝濡?蹂댁옣
                    # (?? ?ы깉 ?낃뎄濡??깅줉??踰쎌? ?좎? ???섎룎?꾧?湲?諛⑹?)
                    if mapping_on and use_map and not self._game_map.is_passable(current_x, current_y) \
                            and not self._game_map.is_blocked(current_x, current_y):
                        self._game_map.mark_passable(current_x, current_y)

                    # 留??대? ?먯깋 ?꾨즺 ??利됱떆 ?쒖같/?꾨즺 (?뚯뒪??紐⑤뱶?먯꽌 ?ы깘??諛⑹?)
                    if boss_mode == "exploring" and boss_patrol is None and len(self._game_map.passable) >= 50:
                        _fnf_ec = _local_explore_center if _local_explore_phase else None
                        _fnf_er = _local_explore_radius if _local_explore_phase else 0
                        if self._game_map.is_fully_explored() or _find_nearest_frontier(
                                current_x, current_y,
                                explore_center=_fnf_ec,
                                explore_radius=_fnf_er,
                                ignore_cooldown=True) is None:
                            boss_no_frontier_count = 10  # ?꾨옒 ?꾨즺 泥댄겕濡?利됱떆 吏꾩엯

                    # ?쒖같 醫뚰몴 ?깅줉??+ 留?異⑸텇???먯깋?????쒖같 紐⑤뱶
                    # 留듭씠 嫄곗쓽 鍮꾩뼱?덉쑝硫?passable < 50) ?먯깋 紐⑤뱶 ?좎? (癒쇱? 留?梨꾩슦湲?
                    # 留듯븨?뚯뒪???꾩껜留듯븨 以묒뿉???쒖같 ?꾪솚 ?ㅽ궢
                    if boss_mode == "exploring" and boss_patrol is None:
                        if self._game_map.patrol_points and len(self._game_map.passable) >= 50:
                            from ..player.map_patroller import MapPatroller
                            boss_patrol = MapPatroller(self._game_map)
                            boss_patrol.start(current_pos_tuple)
                            boss_mode = "patrolling"
                            last_dir = None
                            stuck_count = 0
                            total_stuck_count = 0
                            boss_no_frontier_count = 0
                            # ?댁쟾 ?먯깋 寃쎈줈/?곹깭 珥덇린??(?섎せ??諛⑺뼢 諛⑹?)
                            current_path = []
                            path_index = 0
                            path_pos_index = {}
                            explored_from = {}
                            unknown_path_fails = 0
                            explore_target = None
                            explore_target_tries = 0
                            patrol_skip_count = 0
                            # ?쒖같 ?쒖옉 ???꾩옱 ?꾩튂 ?몄젒 踰??댁젣 (?섎せ??踰??뚮Ц??異쒕컻 紐삵븯??臾몄젣 諛⑹?)
                            # ?? ?ы깉 ?낃뎄(start_pos)???좎?
                            portal_pos = getattr(self._game_map, 'start_pos', None)
                            unblocked_start = 0
                            if not _is_mapping_mode:
                                for d, (ddx, ddy) in DIRECTIONS_4.items():
                                    nx, ny = current_x + ddx, current_y + ddy
                                    if (nx, ny) in _portal_protected:
                                        continue  # ?ы깉 醫뚰몴 蹂댄샇
                                    if (nx, ny) != portal_pos and self._game_map.is_blocked(nx, ny):
                                        self._game_map.mark_passable(nx, ny)
                                        unblocked_start += 1
                            else:
                                self._special_diag(
                                    "wall_unblock_skip_mapping",
                                    iter=iteration,
                                    trigger="patrol_start",
                                    pos=f"{current_x},{current_y}",
                                )
                            pc = len(self._game_map.patrol_points)
                            first_pt = self._game_map.patrol_points[0]
                            self.after(0, lambda: self._append_log(f"{'='*30}"))
                            self.after(0, lambda pc=pc, fp=first_pt, ub=unblocked_start: self._append_log(
                                f"?뵇 ?쒖같紐⑤뱶 ?쒖옉! {pc}媛??쒖같醫뚰몴 ?쒗쉶 (1踰? {fp})" + (f" [?몄젒踰?{ub}媛??댁젣]" if ub else "")))
                            self.after(0, lambda: self._append_log(f"{'='*30}"))

                    if boss_mode == "exploring":
                        # Phase 2 寃쎈줈留듯븨: ?꾨윴?곗뼱 ????ㅼ젣 紐⑺몴濡?吏곹뻾
                        # 留??곗씠???덉쑝硫?passable>=50) 遺遺꾩떎???꾩껜?뚯뒪?몃룄 吏곹뻾
                        _has_mapped = len(self._game_map.passable) >= 50
                        _phase2_direct = (not _local_explore_phase and not full_mapping_exploring
                                           and (_is_mapping_test or _has_mapped))
                        if _phase2_direct:
                            direction = find_path_direction(current_x, current_y, target_x, target_y)
                        else:
                            # ?몄젒 誘명깘????쇱씠 ?덉쑝硫?吏곸젒 吏꾩엯
                            # 怨좎젙 ?쒖꽌 ???留?諛섎났留덈떎 ?쒖옉 諛⑺뼢???뚯쟾 (媛숈? 諛⑺뼢留?諛섎났 諛⑹?)
                            direction = None
                            dir_list = list(DIRECTIONS_4.items())
                            rotate_offset = iteration % len(dir_list)
                            rotated_dirs = dir_list[rotate_offset:] + dir_list[:rotate_offset]
                            unknown_candidates = []
                            _explored_here = explored_from.get((current_x, current_y), set())
                            for d, (ddx, ddy) in rotated_dirs:
                                if d in _explored_here:
                                    continue  # ?대? ?쒕룄+?ㅽ뙣??諛⑺뼢 ?ㅽ궢 (吏꾨룞 諛⑹?)
                                if _is_edge_blocked(current_x, current_y, d, iteration):
                                    continue
                                nx, ny = current_x + ddx, current_y + ddy
                                if not self._game_map.is_known(nx, ny):
                                    # 洹쇱쿂留듯븨 紐⑤뱶: 諛섍꼍 諛뽰씠硫?誘명깘?됱씠?대룄 臾댁떆
                                    if _local_explore_phase and _local_explore_center is not None:
                                        _le_dist = max(abs(nx - _local_explore_center[0]), abs(ny - _local_explore_center[1]))
                                        if _le_dist > _local_explore_radius:
                                            continue
                                    revisit = visit_counts.get((nx, ny), 0)
                                    turn_penalty = 1 if d == last_dir else 0
                                    reverse_penalty = 3 if _opposite_dir(last_dir) == d else 0
                                    unknown_candidates.append((revisit + turn_penalty + reverse_penalty, d, (nx, ny)))
                            if unknown_candidates:
                                unknown_candidates.sort()
                                direction = unknown_candidates[0][1]
                                explore_target = None
                                boss_no_frontier_count = 0
                                if iteration % 5 == 0:
                                    _uc_dirs = [d for _, d, _ in unknown_candidates]
                                    self.after(0, lambda cx=current_x, cy=current_y, d=direction, uc=_uc_dirs:
                                        self._append_log(f"?뿺截?[?먯깋] ({cx},{cy}) ??{d} (誘명깘??{uc})"))

                        # ?놁쑝硫?媛??媛源뚯슫 frontier源뚯? 湲곗〈 A* ?뚭퀬由ъ쬁?쇰줈 ?대룞
                        if direction is None and not _phase2_direct:
                            # ?꾨윴?곗뼱 荑⑤떎??二쇨린 由ъ뀑 (?덈Т ??쑝硫?媛숈? 紐⑺몴 ?ъ떆??
                            if iteration - frontier_cooldown_iter > 60:
                                if frontier_cooldown:
                                    self._special_diag(
                                        "frontier_cooldown_reset",
                                        iter=iteration,
                                        count=len(frontier_cooldown),
                                    )
                                frontier_cooldown.clear()
                                frontier_cooldown_iter = iteration

                            # 湲곗〈 紐⑺몴 ?좏슚??寃利?                            if explore_target is not None:
                                et = explore_target
                                still_ok = et != (current_x, current_y)
                                if still_ok and move_fail_avoid.get(et, 0) > iteration:
                                    still_ok = False
                                    self._special_diag(
                                        "frontier_rejected_fail_avoid",
                                        iter=iteration,
                                        target=f"{et[0]},{et[1]}",
                                        avoid_until=move_fail_avoid.get(et, 0),
                                    )
                                # 紐⑺몴媛 踰쎌씠硫?利됱떆 臾댄슚??                                if still_ok:
                                    still_ok = not self._game_map.is_blocked(et[0], et[1])
                                if still_ok:
                                    still_ok = any(
                                        not self._game_map.is_known(et[0]+ddx, et[1]+ddy)
                                        for ddx, ddy in [(0,-1),(0,1),(-1,0),(1,0)]
                                    )
                                if not still_ok:
                                    frontier_cooldown.add(explore_target)
                                    _remember_recent_frontier(explore_target, "invalid", iteration)
                                    explore_target = None
                                    explore_target_tries = 0

                            if explore_target is None:
                                _ec = _local_explore_center if _local_explore_phase else None
                                _er = _local_explore_radius if _local_explore_phase else 0
                                _radius_steps = [_local_explore_radius] if _local_explore_phase else frontier_radius_steps
                                _selected_radius = None
                                _selected_policy = "skip_recent"
                                for _fr in _radius_steps:
                                    explore_target = _find_nearest_frontier(
                                        current_x, current_y,
                                        max_radius=_fr,
                                        explore_center=_ec,
                                        explore_radius=_er,
                                        skip_recent=True)
                                    if explore_target is not None:
                                        _selected_radius = _fr
                                        break
                                if explore_target is None:
                                    _selected_policy = "allow_recent"
                                    for _fr in _radius_steps:
                                        explore_target = _find_nearest_frontier(
                                            current_x, current_y,
                                            max_radius=_fr,
                                            explore_center=_ec,
                                            explore_radius=_er,
                                            skip_recent=False)
                                        if explore_target is not None:
                                            _selected_radius = _fr
                                            break
                                # 洹쇱쿂留듯븨 紐⑤뱶: 諛섍꼍 ???꾨윴?곗뼱媛 諛섍꼍 諛뽰씠硫?臾댁떆
                                if explore_target and _local_explore_phase and _local_explore_center is not None:
                                    _et_dist = max(abs(explore_target[0] - _local_explore_center[0]), abs(explore_target[1] - _local_explore_center[1]))
                                    if _et_dist > _local_explore_radius:
                                        explore_target = None
                                explore_target_tries = 0
                                if explore_target:
                                    _et_dist_mh = abs(explore_target[0] - current_x) + abs(explore_target[1] - current_y)
                                    self._special_diag(
                                        "frontier_selected",
                                        iter=iteration,
                                        target=f"{explore_target[0]},{explore_target[1]}",
                                        dist=_et_dist_mh,
                                        radius=_selected_radius,
                                        policy=_selected_policy,
                                        recent_size=len(recent_frontiers),
                                    )
                                    self.after(0, lambda et=explore_target, cx=current_x, cy=current_y:
                                        self._append_log(f"?뿺截?[?먯깋] ?꾨윴?곗뼱 紐⑺몴: {et} (?꾩옱:{cx},{cy})"))

                            if explore_target:
                                boss_no_frontier_count = 0
                                direction = find_path_direction(
                                    current_x, current_y,
                                    explore_target[0], explore_target[1])
                                _frontier_left = -1
                                _unreach_limit = 25
                                if _is_mapping_mode:
                                    _fc = _count_frontier_tiles(
                                        explore_center=_local_explore_center if _local_explore_phase else None,
                                        explore_radius=_local_explore_radius if _local_explore_phase else 0,
                                        include_unreachable=True,
                                    )
                                    _frontier_left = _fc
                                    if _fc <= 8:
                                        _unreach_limit = 12
                                    if _fc <= 5:
                                        _unreach_limit = 8
                                    if _fc <= 3:
                                        _unreach_limit = 4
                                if direction is None:
                                    explore_target_tries += 3  # 諛⑺뼢 ?놁쓬 = 鍮좊Ⅴ寃??ш린
                                else:
                                    _bdx, _bdy = DIRECTIONS_4.get(direction, (0, 0))
                                    _dist_now = abs(current_x - explore_target[0]) + abs(current_y - explore_target[1])
                                    _dist_next = abs((current_x + _bdx) - explore_target[0]) + abs((current_y + _bdy) - explore_target[1])
                                    _progress = (_dist_next < _dist_now)
                                    if _is_mapping_mode:
                                        if _progress:
                                            if explore_target_tries > 0:
                                                explore_target_tries -= 1
                                        else:
